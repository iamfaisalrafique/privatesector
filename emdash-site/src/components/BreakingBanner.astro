---
// emdash-site/src/components/BreakingBanner.astro
---

<div class="breaking-banner" style="background-color: #D52B1E; color: #FFFFFF; padding: 6px 0; border-bottom: 1px solid rgba(0, 0, 0, 0.15); overflow: hidden;">
  <div class="container" style="max-width: 1600px; margin: 0 auto; padding: 0 16px; display: flex; align-items: center; gap: 16px;">
    <span class="breaking-label" style="background-color: #000000; color: #FFFFFF; font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 2px; letter-spacing: 0.1em; flex-shrink: 0; text-transform: uppercase;">
      BREAKING NEWS
    </span>
    <div style="flex: 1; overflow: hidden; white-space: nowrap;">
      <marquee scrollamount="4" style="font-family: Inter, sans-serif; font-size: 12px; color: #FFFFFF; font-weight: 500; vertical-align: middle;">
        +++ Swiss Federal Council announces tax relief for private R&D hubs +++ Nestlé expands sustainability audits across agricultural supply chains +++ UBS receives approval for tokenized bond pilot project in Geneva +++ ABB secures major clean electrification agreement in Zurich +++
      </marquee>
    </div>
  </div>
</div>
