---
// emdash-site/src/components/HomepageGraphics.astro
const cantons = [
  { code: 'ZH', name: 'Zürich', count: "124'820", gdp: '21.5%', color: '#D52B1E' },
  { code: 'BE', name: 'Bern', count: "78'410", gdp: '12.8%', color: '#003453' },
  { code: 'GE', name: 'Geneva', count: "46'950", gdp: '9.2%', color: '#8B0000' },
  { code: 'VD', name: 'Vaud', count: "42'110", gdp: '8.7%', color: '#4A6741' },
  { code: 'BS', name: 'Basel-Stadt', count: "28'730", gdp: '7.1%', color: '#D4AF37' },
  { code: 'ZG', name: 'Zug', count: "24'550", gdp: '4.8%', color: '#5A5A5A' },
  { code: 'SG', name: 'St. Gallen', count: "22'180", gdp: '4.2%', color: '#C5A059' },
  { code: 'AG', name: 'Aargau', count: "19'400", gdp: '3.9%', color: '#2B4C7E' },
];

const registerEvents = [
  { id: 1, time: '2m ago', company: 'Roche Holding AG', canton: 'BS', action: 'Board mutation registered', type: 'mutation' },
  { id: 2, time: '5m ago', company: 'UBS Group AG', canton: 'ZH', action: 'Capital increase published', type: 'capital' },
  { id: 3, time: '12m ago', company: 'Stadler Rail AG', canton: 'TG', action: 'Articles of association amended', type: 'statutes' },
  { id: 4, time: '18m ago', company: 'Glencore International AG', canton: 'ZG', action: 'Power of attorney registered', type: 'signatory' },
  { id: 5, time: '25m ago', company: 'Nestlé S.A.', canton: 'VD', action: 'New branch registered in Vevey', type: 'branch' },
  { id: 6, time: '35m ago', company: 'Swisscom AG', canton: 'BE', action: 'Corporate signatory update', type: 'mutation' }
];
---

<section class="my-12">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- 1. Cantonal GDP & Density Card -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 sm:p-7 shadow-xs">
      <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div>
          <span class="text-[10px] font-bold text-red-600 dark:text-red-400 uppercase tracking-wider block">
            REGIONAL DENSITY
          </span>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Cantonal GDP & Enterprise Share
          </h3>
        </div>
        <a href="/statistiken" class="text-xs font-semibold text-red-600 dark:text-red-400 hover:underline">
          Full Matrix →
        </a>
      </div>

      <div class="space-y-3.5">
        {cantons.map((c) => (
          <div>
            <div class="flex items-center justify-between text-xs mb-1.5">
              <span class="font-semibold text-slate-800 dark:text-slate-200">
                {c.name} ({c.code})
              </span>
              <span class="text-slate-500 dark:text-slate-400 tabular-nums font-medium">
                {c.count} firms • {c.gdp} GDP
              </span>
            </div>
            <div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
              <div 
                class="h-full rounded-full transition-all duration-500" 
                style={`width: ${c.gdp}; background-color: ${c.color};`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 2. Live Commercial Register Feed Card -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 sm:p-7 shadow-xs">
      <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div>
          <span class="text-[10px] font-bold text-red-600 dark:text-red-400 uppercase tracking-wider block">
            REGISTRY RADAR
          </span>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Commercial Register Ledger (SOGC/SHAB)
          </h3>
        </div>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Live Feed</span>
        </span>
      </div>

      <div class="space-y-3">
        {registerEvents.map((evt) => (
          <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60 flex items-start justify-between gap-3">
            <div class="space-y-0.5 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="font-bold text-xs text-slate-900 dark:text-white truncate">
                  {evt.company}
                </span>
                <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                  {evt.canton}
                </span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 truncate">
                {evt.action}
              </p>
            </div>
            <span class="text-[11px] text-slate-400 dark:text-slate-500 shrink-0 tabular-nums">
              {evt.time}
            </span>
          </div>
        ))}
      </div>

      <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800 text-center">
        <a href="/unternehmen" class="text-xs font-semibold text-red-600 dark:text-red-400 hover:underline">
          Search Complete Commercial Register →
        </a>
      </div>
    </div>

  </div>
</section>
