---
// emdash-site/src/components/CompanyCard.astro
interface Props {
  company: {
    id: number | string;
    name: string;
    logo_bg?: string | null;
    canton?: string | null;
    industry?: string | null;
    size_class?: string | null;
    description?: string | null;
    premium?: number | boolean | null;
    verified?: number | boolean | null;
    founded?: number | string | null;
    employees?: number | string | null;
    slug?: string | null;
  };
}

const { company: comp } = Astro.props;
const isPremium = comp.premium === 1 || comp.premium === true;
const isVerified = comp.verified === 1 || comp.verified === true;
const targetUrl = `/unternehmen/${comp.slug || comp.id}`;

// High-Fidelity Vector Brand Marks for Swiss Flagship Enterprises
const normalizedName = (comp.name || '').toLowerCase();
const isNestle = normalizedName.includes('nestle') || normalizedName.includes('nestlé');
const isRoche = normalizedName.includes('roche');
const isUbs = normalizedName.includes('ubs');
const isRolex = normalizedName.includes('rolex');
const isNovartis = normalizedName.includes('novartis');
const isStadler = normalizedName.includes('stadler');
const isGlencore = normalizedName.includes('glencore');
const isSwisscom = normalizedName.includes('swisscom');
const isAbb = normalizedName.includes('abb');

const logoInitial = comp.name ? comp.name.charAt(0).toUpperCase() : 'C';
---

<a 
  href={targetUrl}
  class="group relative flex flex-col justify-between h-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 shadow-xs hover:shadow-xl hover:border-red-500/30 dark:hover:border-red-500/30 hover:-translate-y-1.5 transition-all duration-300 overflow-hidden"
>
  <!-- Subtle Gradient Accent Glow on Top Right -->
  <div class="absolute -top-12 -right-12 w-28 h-28 bg-gradient-to-br from-red-500/5 to-amber-500/5 dark:from-red-500/10 dark:to-transparent rounded-full blur-2xl pointer-events-none group-hover:from-red-500/15 transition-all duration-500"></div>

  <div>
    <!-- Top Row: Brand Emblem & Premium Badge -->
    <div class="flex items-start justify-between gap-4 mb-4">
      
      <!-- Brand Emblem / Vector Logo -->
      <div class="relative shrink-0">
        {isNestle && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-blue-900 via-blue-950 to-slate-900 flex items-center justify-center text-white shadow-md border border-blue-800/40">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 14s1.5 2 4 2 4-2 4-2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 10h.01M15 10h.01" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v4" />
            </svg>
          </div>
        )}
        {isRoche && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-900 flex items-center justify-center text-white shadow-md border border-blue-500/40">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L3.5 7v10L12 22l8.5-5V7L12 2zm0 3.5l5.5 3.2v6.6L12 18.5l-5.5-3.2v-6.6L12 5.5z" />
              <circle cx="12" cy="12" r="2.5" fill="white" />
            </svg>
          </div>
        )}
        {isUbs && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-black via-zinc-900 to-stone-900 flex items-center justify-center text-white shadow-md border border-zinc-800">
            <svg class="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="8" cy="8" r="3" />
              <path d="M10.5 9.5L16 15M14 13l2 2M15 11l2 2" stroke-linecap="round" />
              <circle cx="16" cy="7" r="2" />
              <circle cx="12" cy="17" r="2" />
            </svg>
          </div>
        )}
        {isRolex && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-emerald-950 via-emerald-900 to-teal-950 flex items-center justify-center text-white shadow-md border border-emerald-700/50">
            <svg class="w-7 h-7 text-amber-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5 16L3 7l4.5 4.5L12 5l4.5 6.5L21 7l-2 9H5zm0 2h14v2H5v-2z" />
            </svg>
          </div>
        )}
        {isNovartis && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-amber-600 via-orange-600 to-red-700 flex items-center justify-center text-white shadow-md border border-orange-500/40">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
        )}
        {isStadler && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-slate-900 via-red-950 to-red-800 flex items-center justify-center text-white shadow-md border border-red-700/40">
            <span class="font-black text-sm tracking-tighter text-white">STAD</span>
          </div>
        )}
        {isSwisscom && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-blue-700 via-sky-600 to-cyan-500 flex items-center justify-center text-white shadow-md border border-sky-400/40">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
            </svg>
          </div>
        )}
        {isAbb && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center text-white shadow-md border border-red-500">
            <span class="font-black text-base tracking-widest text-white">ABB</span>
          </div>
        )}
        {isGlencore && (
          <div class="w-13 h-13 rounded-2xl bg-gradient-to-br from-slate-800 via-slate-900 to-zinc-950 flex items-center justify-center text-white shadow-md border border-slate-700">
            <svg class="w-7 h-7 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
          </div>
        )}
        {!isNestle && !isRoche && !isUbs && !isRolex && !isNovartis && !isStadler && !isSwisscom && !isAbb && !isGlencore && (
          <div 
            class="w-13 h-13 rounded-2xl flex items-center justify-center font-black text-lg text-white shadow-md border border-slate-200/80 dark:border-slate-700 bg-gradient-to-br from-slate-800 to-slate-950"
          >
            {logoInitial}
          </div>
        )}
      </div>

      <!-- Top Right: Premium & Canton Badges -->
      <div class="flex flex-col items-end gap-1.5">
        {isPremium && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-red-50 dark:bg-red-950/80 text-[#D52B1E] dark:text-red-400 border border-red-200/80 dark:border-red-900/60 uppercase tracking-wider shadow-2xs">
            <span class="text-amber-500 dark:text-amber-400">★</span>
            PREMIUM
          </span>
        )}
        {comp.canton && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
            <span class="text-[9px] font-mono text-red-600 dark:text-red-400 font-extrabold">CH</span>
            <span>{comp.canton}</span>
          </span>
        )}
      </div>
    </div>

    <!-- Company Information -->
    <div class="space-y-2">
      <h3 class="text-base font-extrabold text-slate-900 dark:text-white group-hover:text-[#D52B1E] dark:group-hover:text-red-400 transition-colors leading-snug truncate">
        {comp.name}
      </h3>

      {comp.industry && (
        <span class="inline-block text-xs font-semibold text-slate-500 dark:text-slate-400">
          {comp.industry}
        </span>
      )}

      <!-- Description -->
      {comp.description && (
        <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed pt-1">
          {comp.description}
        </p>
      )}
    </div>
  </div>

  <!-- Footer Metadata & Verification -->
  <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
    <div class="flex items-center gap-2 font-mono text-[11px] text-slate-500 dark:text-slate-400">
      <span>{comp.founded ? `Est. ${comp.founded}` : 'Active'}</span>
      {comp.size_class && (
        <>
          <span>•</span>
          <span class="font-sans text-[10px] uppercase font-bold text-slate-400">{comp.size_class}</span>
        </>
      )}
    </div>

    {isVerified && (
      <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-bold text-[11px]">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Verified Swiss</span>
      </span>
    )}
  </div>
</a>
