---
// emdash-site/src/components/CompanyCard.astro
interface Props {
  company: {
    id: number | string;
    name: string;
    logo_bg?: string | null;
    canton?: string | null;
    industry?: string | null;
    size_class?: string | null;
    description?: string | null;
    premium?: number | boolean | null;
    verified?: number | boolean | null;
    founded?: number | string | null;
    employees?: number | string | null;
    slug?: string | null;
  };
}

const { company: comp } = Astro.props;
const logoInitial = comp.name ? comp.name.charAt(0) : 'C';
const isPremium = comp.premium === 1 || comp.premium === true;
const isVerified = comp.verified === 1 || comp.verified === true;
const targetUrl = `/unternehmen/${comp.slug || comp.id}`;
---

<a 
  href={targetUrl}
  class="group flex flex-col justify-between h-full bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-xs hover:shadow-lg hover:-translate-y-1 transition-all duration-200 relative overflow-hidden"
>
  {isPremium && (
    <div class="absolute top-4 right-4">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900/60 uppercase tracking-wider">
        PREMIUM
      </span>
    </div>
  )}

  <div class="space-y-4">
    <!-- Header with Avatar and Basic Info -->
    <div class="flex items-start gap-3.5">
      <div 
        class="w-12 h-12 rounded-xl flex items-center justify-center font-bold text-lg text-slate-900 dark:text-white shrink-0 border border-slate-200 dark:border-slate-700 shadow-2xs"
        style={`background-color: ${comp.logo_bg || '#F1F5F9'};`}
      >
        {logoInitial}
      </div>

      <div class="min-w-0 flex-1 pr-16">
        <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors truncate">
          {comp.name}
        </h3>
        <div class="flex items-center gap-1.5 flex-wrap mt-1">
          {comp.canton && (
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              📍 {comp.canton}
            </span>
          )}
          {comp.industry && (
            <span class="text-xs text-slate-500 dark:text-slate-400 truncate">
              {comp.industry}
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Description -->
    {comp.description && (
      <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
        {comp.description}
      </p>
    )}
  </div>

  <!-- Footer Metadata -->
  <div class="mt-4 pt-3.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-400">
    <span class="tabular-nums">
      {comp.founded ? `Est. ${comp.founded}` : 'Verified Entity'}
    </span>
    {isVerified && (
      <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-semibold text-[11px]">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span>Verified Swiss</span>
      </span>
    )}
  </div>
</a>
