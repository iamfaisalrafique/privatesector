---
// emdash-site/src/components/Hero.astro
const stats = [
  { value: "500'000+", label: 'Registered Enterprises' },
  { value: "26", label: 'Cantons Covered' },
  { value: "CHF 4.2T", label: 'National Market Cap' },
  { value: "50'000+", label: 'Business Decision-Makers' },
];

const topicPills = [
  { label: 'All Topics', path: '/news' },
  { label: 'Pharma & Biotech', path: '/news?category=pharma' },
  { label: 'Banking & Wealth', path: '/news?category=banking' },
  { label: 'Precision Tech', path: '/news?category=technology' },
  { label: 'Consumer Goods', path: '/news?category=consumer' },
  { label: 'Trade & Policy', path: '/trade-policy-pulse' },
  { label: 'Cantonal Heatmap', path: '/statistiken' },
];
---

<section class="relative overflow-hidden py-10 md:py-14 bg-gradient-to-b from-white via-slate-50/40 to-slate-50 dark:from-slate-950 dark:via-slate-900/60 dark:to-slate-950 border-b border-slate-200/70 dark:border-slate-800/70 transition-colors">
  
  <!-- Subtle Ambient Glow -->
  <div class="pointer-events-none absolute -top-40 -right-40 h-96 w-96 rounded-full bg-red-500/5 blur-3xl dark:bg-red-500/10"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-blue-500/5 blur-3xl dark:bg-blue-500/10"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
      
      <!-- Left Column: Modern Minimalist Headline & Topic Filters -->
      <div class="space-y-6 lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-red-200/80 bg-red-50/80 px-3 py-1 text-xs font-semibold text-[#D52B1E] dark:border-red-900/50 dark:bg-red-950/60 dark:text-red-400">
          <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
          <span>Switzerland's Authoritative Business Intelligence</span>
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl leading-[1.12] dark:text-white">
          Independent Intelligence on the Swiss Private Sector.
        </h1>

        <p class="max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
          Unrivaled corporate dossiers on 500,000+ Swiss commercial entities, real-time registry mutations, daily morning briefings, and cross-border investment corridors.
        </p>

        <!-- Quick Topic Filter Pills -->
        <div class="pt-2">
          <span class="block text-xs font-bold tracking-wider text-slate-400 uppercase dark:text-slate-500 mb-2.5">
            Explore Strategic Intelligence:
          </span>
          <div class="flex flex-wrap items-center gap-2">
            {topicPills.map((pill, idx) => (
              <a
                href={pill.path}
                class={`rounded-full px-3.5 py-1.5 text-xs font-medium transition-all shadow-2xs ${
                  idx === 0
                    ? 'bg-slate-900 text-white font-semibold dark:bg-slate-100 dark:!text-slate-950 shadow-xs'
                    : 'bg-white text-slate-700 border border-slate-200/90 hover:border-[#D52B1E]/40 hover:text-[#D52B1E] dark:bg-slate-900 dark:border-slate-800 dark:text-slate-300 dark:hover:border-red-800 dark:hover:text-red-400'
                }`}
              >
                {pill.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Swiss Economic Snapshot Card -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-slate-200/80 bg-white/95 p-6 shadow-sm backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/95 sm:p-7">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
            <div>
              <span class="block text-[10px] font-bold tracking-wider text-[#D52B1E] uppercase dark:text-red-400">
                MACRO INTELLIGENCE
              </span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                Swiss Economic Snapshot 2026
              </h3>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold text-emerald-700 dark:border-emerald-900/40 dark:bg-emerald-950/50 dark:text-emerald-400">
              <span class="h-1 w-1 rounded-full bg-emerald-500"></span>
              Live Verified
            </span>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3.5">
            {stats.map((s) => (
              <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4 transition hover:bg-slate-50 dark:border-slate-800/60 dark:bg-slate-800/40 dark:hover:bg-slate-800/70">
                <div class="font-mono text-xl font-extrabold text-slate-900 sm:text-2xl dark:text-white">
                  {s.value}
                </div>
                <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">
                  {s.label}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-5 border-t border-slate-100 pt-4 dark:border-slate-800">
            <a 
              href="/statistiken" 
              class="flex items-center justify-between text-xs font-bold text-[#D52B1E] transition hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
            >
              <span>Explore Cantonal Heatmap & GDP Density</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
