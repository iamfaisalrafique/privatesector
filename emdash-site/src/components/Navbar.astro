  <style>
    @keyframes megaMenuFadeIn {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #desktop-mega-menu {
      display: none !important;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-6px);
      transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    }

    #desktop-mega-menu.is-active {
      display: block !important;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .top-market-bar::-webkit-scrollbar {
      display: none;
    }

    .mega-menu-link:hover {
      color: #D52B1E !important;
      transform: translateX(2px);
    }

    .mega-menu-link:hover svg {
      stroke: #D52B1E !important;
    }

    .nav-link-item:hover {
      color: #D52B1E !important;
    }

    @media (min-width: 1025px) {
      .desktop-only {
        display: flex !important;
      }
      .mobile-only {
        display: none !important;
      }
    }

    @media (max-width: 1024px) {
      .desktop-only {
        display: none !important;
      }
      .mobile-only {
        display: block !important;
      }
      .mobile-drawer-overlay.is-open {
        display: flex !important;
      }
    }
  </style>

  <script is:inline data-astro-rerun>
    // Live Zurich CET Time
    function initZurichClock() {
      const el = document.getElementById('zurich-live-time');
      if (!el) return;
      try {
        const now = new Date();
        const formatted = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/Zurich',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true
        }).format(now);
        el.textContent = formatted + ' CET';
      } catch (e) {
        el.textContent = '08:30 AM CET';
      }
    }
    initZurichClock();
    setInterval(initZurichClock, 30000);

    // Desktop Mega Menu Hover System
    const navLinksCluster = document.getElementById('desktop-nav-cluster');
    const megaMenu = document.getElementById('desktop-mega-menu');
    let megaTimeout = null;

    if (navLinksCluster && megaMenu) {
      function showMega() {
        if (megaTimeout) clearTimeout(megaTimeout);
        megaMenu.classList.add('is-active');
      }

      function hideMega() {
        if (megaTimeout) clearTimeout(megaTimeout);
        megaTimeout = setTimeout(() => {
          megaMenu.classList.remove('is-active');
        }, 120);
      }

      navLinksCluster.addEventListener('mouseenter', showMega);
      navLinksCluster.addEventListener('mouseleave', hideMega);
      megaMenu.addEventListener('mouseenter', showMega);
      megaMenu.addEventListener('mouseleave', hideMega);

      // Close when cursor leaves navigation area towards logo or action buttons
      const brandLogo = document.querySelector('a[href="/"]');
      const searchBtn = document.getElementById('search-toggle-btn');
      const adminBtn = document.querySelector('a[href="/login"]');
      [brandLogo, searchBtn, adminBtn].forEach((el) => {
        if (el) el.addEventListener('mouseenter', () => {
          if (megaTimeout) clearTimeout(megaTimeout);
          megaMenu.classList.remove('is-active');
        });
      });

      // Close immediately on link click
      document.querySelectorAll('.nav-link-item, .mega-menu-link').forEach((link) => {
        link.addEventListener('click', () => {
          megaMenu.classList.remove('is-active');
        });
      });

      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          megaMenu.classList.remove('is-active');
        }
      });
    }

    // Search Bar Overlay Toggle
    const searchBtn = document.getElementById('search-toggle-btn');
    const searchCloseBtn = document.getElementById('search-close-btn');
    const searchOverlay = document.getElementById('search-overlay');

    if (searchBtn && searchOverlay) {
      searchBtn.addEventListener('click', () => {
        const isHidden = searchOverlay.style.display === 'none' || !searchOverlay.style.display;
        searchOverlay.style.display = isHidden ? 'block' : 'none';
        if (isHidden) {
          const input = searchOverlay.querySelector('input');
          if (input) input.focus();
        }
      });
    }

    if (searchCloseBtn && searchOverlay) {
      searchCloseBtn.addEventListener('click', () => {
        searchOverlay.style.display = 'none';
      });
    }

    // Mobile Drawer Open & Close
    const mobOpenBtn = document.getElementById('mobile-menu-btn');
    const mobCloseBtn = document.getElementById('mobile-drawer-close');
    const mobSearchBtn = document.getElementById('mobile-search-btn');
    const mobDrawer = document.getElementById('mobile-drawer-overlay');

    if (mobOpenBtn && mobDrawer) {
      mobOpenBtn.addEventListener('click', () => {
        mobDrawer.classList.add('is-open');
        mobDrawer.style.display = 'flex';
      });
    }

    if (mobCloseBtn && mobDrawer) {
      mobCloseBtn.addEventListener('click', () => {
        mobDrawer.classList.remove('is-open');
        mobDrawer.style.display = 'none';
      });
    }

    if (mobSearchBtn && mobDrawer && searchOverlay) {
      mobSearchBtn.addEventListener('click', () => {
        mobDrawer.classList.remove('is-open');
        mobDrawer.style.display = 'none';
        searchOverlay.style.display = 'block';
        const input = searchOverlay.querySelector('input');
        if (input) input.focus();
      });
    }

    // Mobile Accordion Expansions
    const accordions = document.querySelectorAll('.mobile-accordion-header');
    accordions.forEach((header) => {
      header.addEventListener('click', () => {
        const isHome = header.getAttribute('data-is-home') === 'true';
        if (isHome) {
          window.location.href = '/';
          return;
        }

        const targetId = header.getAttribute('data-target');
        const body = document.getElementById(targetId);
        const chevron = header.querySelector('.chevron-icon');

        if (body) {
          const isOpen = body.style.display === 'flex';
          // Close all other accordions
          document.querySelectorAll('.mobile-accordion-body').forEach((b) => {
            b.style.display = 'none';
          });
          document.querySelectorAll('.chevron-icon').forEach((c) => {
            c.style.transform = 'rotate(0deg)';
          });

          if (!isOpen) {
            body.style.display = 'flex';
            if (chevron) chevron.style.transform = 'rotate(180deg)';
          }
        }
      });
    });
  </script>
</header>
