---
// emdash-site/src/components/Navbar.astro
interface Props {
  currentLocale?: string;
}

const { currentLocale = "en" } = Astro.props;
const currentPath = Astro.url.pathname;

const sectionsData = [
  {
    id: 'home',
    label: 'HOME',
    icon: 'home',
    flag: null,
    path: '/',
    subtitle: "Today's top intelligence",
    items: [
      { label: 'Top Story', path: '/news' },
      { label: 'Latest Intelligence', path: '/news' },
      { label: 'Breaking News', path: '/news' },
      { label: "Editor's Picks", path: '/blogs' },
      { label: 'CEO Interviews', path: '/interviews' },
      { label: 'Morning Briefings', path: '/news' },
    ]
  },
  {
    id: 'switzerland',
    label: 'SWITZERLAND',
    icon: null,
    flag: 'swiss',
    path: '/trade-policy-pulse',
    subtitle: 'Swiss business & economy',
    items: [
      { label: 'Swiss Commercial Registry', path: '/unternehmen' },
      { label: 'Cantonal Heatmap & GDP', path: '/statistiken' },
      { label: 'Market Rankings', path: '/ranking' },
      { label: 'Trade & Policy Pulse', path: '/trade-policy-pulse' },
      { label: 'SOGC / SHAB Gazette', path: '/#ledger' },
      { label: 'Verified Partners', path: '/unternehmen?verified=true' },
    ]
  },
  {
    id: 'usa',
    label: 'USA & CORRIDORS',
    icon: null,
    flag: 'usa',
    path: '/socal-gateway',
    subtitle: 'U.S. business & policy',
    items: [
      { label: 'SoCal Gateway Corridor', path: '/socal-gateway' },
      { label: 'Transatlantic Transcript', path: '/translatic-transcript' },
      { label: 'Trade & Policy Pulse', path: '/trade-policy-pulse' },
      { label: 'Cross-Border Capital Flows', path: '/cross-border-ranking' },
      { label: 'U.S. Corporate Presence', path: '/unternehmen' },
      { label: 'States & Innovation Hubs', path: '/socal-gateway' },
    ]
  },
  {
    id: 'companies',
    label: 'COMPANIES',
    icon: 'building',
    flag: null,
    path: '/unternehmen',
    subtitle: 'Corporate registry & hubs',
    items: [
      { label: 'Swiss Enterprise Directory', path: '/unternehmen' },
      { label: 'Pharma & Life Sciences', path: '/unternehmen' },
      { label: 'Private Banking & Wealth', path: '/unternehmen' },
      { label: 'Precision Engineering', path: '/unternehmen' },
      { label: 'Top 50 Market Benchmark', path: '/ranking' },
      { label: 'Verified Partners Registry', path: '/unternehmen?verified=true' },
    ]
  },
  {
    id: 'startups',
    label: 'STARTUPS & TECH',
    icon: 'rocket',
    flag: null,
    path: '/statistiken',
    subtitle: 'Innovation on both sides',
    items: [
      { label: 'Swiss Startup Radar', path: '/statistiken' },
      { label: 'CEO & Founder Dialogues', path: '/interviews' },
      { label: 'Venture Capital & Funding', path: '/statistiken' },
      { label: 'Advanced Robotics & AI', path: '/news' },
      { label: 'Life Sciences Incubators', path: '/news' },
      { label: 'SOGC New Formations', path: '/#ledger' },
    ]
  },
  {
    id: 'markets',
    label: 'MARKETS & DATA',
    icon: 'chart',
    flag: null,
    path: '/statistiken',
    subtitle: 'Financial benchmarks',
    items: [
      { label: 'Swiss Market Index (SMI)', path: '/statistiken' },
      { label: 'Cantonal Economic Matrix', path: '/statistiken' },
      { label: 'Cross-Border Rankings', path: '/cross-border-ranking' },
      { label: 'Treasury Yield Impact', path: '/news/the-5-question-what-higher-us-treasury-yields-mean-for-swiss-investment-in-america' },
      { label: 'Foreign Exchange & Gold', path: '/statistiken' },
      { label: 'Cantonal Heatmap', path: '/statistiken' },
    ]
  },
  {
    id: 'corridors',
    label: 'CORRIDORS',
    icon: 'target',
    flag: null,
    path: '/cross-border-ranking',
    subtitle: 'Where opportunity meets capital',
    items: [
      { label: 'Swiss → U.S. Expansion', path: '/socal-gateway' },
      { label: 'U.S. → Switzerland Gateway', path: '/translatic-transcript' },
      { label: 'Cross-Border Rankings', path: '/cross-border-ranking' },
      { label: 'Bilateral Joint Ventures', path: '/trade-policy-pulse' },
      { label: 'Cantonal Tax & Business Hubs', path: '/statistiken' },
      { label: 'Executive Dispatches', path: '/blogs' },
    ]
  }
];

const navTabs = [
  { id: 'home', label: 'Home', path: '/' },
  { id: 'switzerland', label: 'Switzerland', path: '/trade-policy-pulse', flag: 'swiss' },
  { id: 'usa', label: 'USA & Corridors', path: '/socal-gateway', flag: 'usa' },
  { id: 'companies', label: 'Companies', path: '/unternehmen', icon: 'building' },
  { id: 'startups', label: 'Startups & Tech', path: '/statistiken', icon: 'rocket' },
  { id: 'markets', label: 'Markets & Data', path: '/statistiken', icon: 'chart' },
  { id: 'corridors', label: 'Corridors', path: '/cross-border-ranking', icon: 'target' },
];

const tickers = [
  { label: 'SMI', val: "12'123.42", chg: '+0.45%', up: true },
  { label: 'EUR/CHF', val: '0.9431', chg: '+0.18%', up: true },
  { label: 'USD/CHF', val: '0.8742', chg: '+0.21%', up: true },
  { label: 'S&P 500', val: "5'344.16", chg: '-0.31%', up: false },
  { label: 'Gold (oz)', val: '$2,345.10', chg: '+0.35%', up: true },
];

const languages = [
  { code: 'en', label: 'EN' },
  { code: 'de', label: 'DE' },
  { code: 'fr', label: 'FR' },
  { code: 'ar', label: 'عربي' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-slate-950/95 backdrop-blur-md shadow-xs transition-colors">
  <!-- 1. Google Material 3 Main Navigation Bar -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4 md:gap-6">
      
      <!-- Left: Brand Logo -->
      <div class="flex items-center shrink-0">
        <a href="/" class="group flex items-center gap-2 focus:outline-none" aria-label="PrivateSector.ch Home">
          <img 
            src="/logo.png" 
            alt="PrivateSector.ch" 
            class="h-8 md:h-9 w-auto object-contain transition-transform group-hover:scale-[1.02] dark:brightness-0 dark:invert" 
          />
        </a>
      </div>

      <!-- Center: Prominent Google-Style Pill Search Input -->
      <div class="flex flex-1 max-w-lg mx-auto">
        <form action="/news" method="GET" class="w-full relative group">
          <div class="relative flex items-center">
            <svg 
              class="pointer-events-none absolute left-4 h-4 w-4 text-slate-400 transition group-focus-within:text-[#D52B1E]" 
              xmlns="http://www.w3.org/2000/svg" 
              viewBox="0 0 20 20" 
              fill="currentColor"
            >
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
            <input
              type="text"
              name="search"
              placeholder="Search Swiss intelligence, enterprises, cantons..."
              class="w-full rounded-full border border-slate-200/90 bg-slate-50/80 py-2 pl-11 pr-12 text-sm text-slate-900 shadow-inner-sm transition-all outline-none placeholder:text-slate-400 focus:border-[#D52B1E]/60 focus:bg-white focus:ring-4 focus:ring-red-500/10 dark:border-slate-800 dark:bg-slate-900/80 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-red-500 dark:focus:bg-slate-900 dark:focus:ring-red-950/40"
            />
            <span class="pointer-events-none absolute right-3.5 hidden rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 sm:inline-block dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500">
              ↵
            </span>
          </div>
        </form>
      </div>

      <!-- Right: Utility Controls (Theme, Language, Admin, Mobile Toggle) -->
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle Color Theme"
          class="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white focus:outline-none"
        >
          <svg id="theme-moon" class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg id="theme-sun" class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>

        <!-- Language Dropdown -->
        <div class="relative">
          <button
            id="lang-menu-btn"
            type="button"
            class="flex items-center gap-1 rounded-full border border-slate-200/90 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 focus:outline-none"
          >
            <span>{currentLocale.toUpperCase()}</span>
            <svg class="h-3 w-3 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="lang-menu-dropdown"
            class="absolute right-0 mt-2 hidden w-28 rounded-2xl border border-slate-200 bg-white py-1.5 shadow-lg backdrop-blur-md dark:border-slate-800 dark:bg-slate-900 z-50"
          >
            {languages.map((l) => (
              <a
                href={`?locale=${l.code}`}
                class={`block px-3 py-1.5 text-xs transition ${
                  currentLocale === l.code
                    ? 'font-bold text-[#D52B1E] bg-red-50/60 dark:bg-red-950/40 dark:text-red-400'
                    : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'
                }`}
              >
                {l.label} ({l.code.toUpperCase()})
              </a>
            ))}
          </div>
        </div>

        <!-- Sleek Admin Button -->
        <a
          href="/admin"
          class="hidden sm:inline-flex items-center justify-center rounded-full bg-[#D52B1E] px-4 py-1.5 text-xs font-bold text-white shadow-xs transition hover:bg-red-700 hover:shadow-sm"
        >
          Admin
        </a>

        <!-- Mobile Drawer Toggle -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open mobile navigation menu"
          class="flex lg:hidden h-9 w-9 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 focus:outline-none"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- 2. Interactive Navigation Tabs Bar (With Apple / Google M3 Expressive Mega Menu Trigger) -->
  <div class="relative border-t border-slate-100 bg-white/70 dark:border-slate-850 dark:bg-slate-950/70 transition-colors">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="hidden lg:flex items-center justify-between gap-2 py-1.5" id="nav-tabs-container">
        <!-- Tabs Cluster -->
        <nav class="flex items-center gap-1 overflow-x-auto no-scrollbar">
          {navTabs.map((tab) => {
            const isActive = currentPath === tab.path || (tab.path !== '/' && currentPath.startsWith(tab.path));
            return (
              <a
                href={tab.path}
                class={`group flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-medium transition-all ${
                  isActive
                    ? 'bg-slate-900 text-white font-semibold dark:bg-slate-100 dark:!text-slate-950 shadow-xs'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-900 dark:hover:text-white'
                }`}
              >
                {tab.flag === 'swiss' && (
                  <svg width="13" height="10" viewBox="0 0 32 24" class="rounded-xs shrink-0 shadow-xs">
                    <rect width="32" height="24" fill="#D52B1E" />
                    <rect x="13" y="4" width="6" height="16" fill="#FFFFFF" />
                    <rect x="7" y="9" width="18" height="6" fill="#FFFFFF" />
                  </svg>
                )}
                {tab.flag === 'usa' && (
                  <svg width="13" height="10" viewBox="0 0 32 24" class="rounded-xs shrink-0 shadow-xs">
                    <rect width="32" height="24" fill="#B22234" />
                    <rect y="3.69" width="32" height="1.85" fill="#FFFFFF" />
                    <rect y="7.38" width="32" height="1.85" fill="#FFFFFF" />
                    <rect y="11.08" width="32" height="1.85" fill="#FFFFFF" />
                    <rect y="14.77" width="32" height="1.85" fill="#FFFFFF" />
                    <rect y="18.46" width="32" height="1.85" fill="#FFFFFF" />
                    <rect y="22.15" width="32" height="1.85" fill="#FFFFFF" />
                    <rect width="13" height="13" fill="#3C3B6E" />
                    <circle cx="3.5" cy="3.5" r="1" fill="#FFFFFF" />
                    <circle cx="9.5" cy="3.5" r="1" fill="#FFFFFF" />
                    <circle cx="6.5" cy="6.5" r="1" fill="#FFFFFF" />
                    <circle cx="3.5" cy="9.5" r="1" fill="#FFFFFF" />
                    <circle cx="9.5" cy="9.5" r="1" fill="#FFFFFF" />
                  </svg>
                )}
                <span>{tab.label}</span>
              </a>
            );
          })}
        </nav>

        <!-- Dedicated Mega Menu Trigger Pill -->
        <button
          id="mega-menu-trigger-btn"
          type="button"
          aria-expanded="false"
          aria-controls="desktop-mega-menu"
          class="group flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-bold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 transition-all cursor-pointer shrink-0 shadow-xs border border-slate-200/60 dark:border-slate-800"
        >
          <svg class="h-3.5 w-3.5 text-[#D52B1E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Mega Menu</span>
          <svg id="mega-chevron" class="h-3 w-3 text-slate-400 group-hover:text-slate-700 dark:group-hover:text-white transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 3. Desktop Apple / Google Expressive Mega Menu Dropdown -->
    <div
      id="desktop-mega-menu"
      class="absolute top-full left-0 right-0 w-full bg-white dark:bg-[#0A0F1D] border-t border-b border-slate-200 dark:border-slate-800 shadow-2xl z-50"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-7">
        <!-- 7-Column Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-5 lg:gap-4">
          {sectionsData.map((sec, secIdx) => (
            <div class={`flex flex-col ${secIdx < sectionsData.length - 1 ? 'lg:border-r lg:border-slate-100 dark:lg:border-slate-850/80 lg:pr-3' : ''}`}>
              <!-- Section Header -->
              <a href={sec.path} class="group block mb-3 text-decoration-none">
                <div class="flex items-center gap-1.5 mb-1">
                  {sec.flag === 'swiss' && (
                    <svg width="15" height="11" viewBox="0 0 32 24" class="rounded-xs shrink-0 shadow-xs">
                      <rect width="32" height="24" fill="#D52B1E" />
                      <rect x="13" y="4" width="6" height="16" fill="#FFFFFF" />
                      <rect x="7" y="9" width="18" height="6" fill="#FFFFFF" />
                    </svg>
                  )}
                  {sec.flag === 'usa' && (
                    <svg width="15" height="11" viewBox="0 0 32 24" class="rounded-xs shrink-0 shadow-xs">
                      <rect width="32" height="24" fill="#B22234" />
                      <rect y="3.69" width="32" height="1.85" fill="#FFFFFF" />
                      <rect y="7.38" width="32" height="1.85" fill="#FFFFFF" />
                      <rect y="11.08" width="32" height="1.85" fill="#FFFFFF" />
                      <rect y="14.77" width="32" height="1.85" fill="#FFFFFF" />
                      <rect y="18.46" width="32" height="1.85" fill="#FFFFFF" />
                      <rect y="22.15" width="32" height="1.85" fill="#FFFFFF" />
                      <rect width="13" height="13" fill="#3C3B6E" />
                      <circle cx="3.5" cy="3.5" r="1" fill="#FFFFFF" />
                      <circle cx="9.5" cy="3.5" r="1" fill="#FFFFFF" />
                      <circle cx="6.5" cy="6.5" r="1" fill="#FFFFFF" />
                      <circle cx="3.5" cy="9.5" r="1" fill="#FFFFFF" />
                      <circle cx="9.5" cy="9.5" r="1" fill="#FFFFFF" />
                    </svg>
                  )}
                  {sec.icon === 'home' && (
                    <svg class="h-3.5 w-3.5 text-[#D52B1E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                  )}
                  {sec.icon === 'building' && (
                    <svg class="h-3.5 w-3.5 text-[#D52B1E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>
                    </svg>
                  )}
                  {sec.icon === 'rocket' && (
                    <svg class="h-3.5 w-3.5 text-[#D52B1E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                    </svg>
                  )}
                  {sec.icon === 'chart' && (
                    <svg class="h-3.5 w-3.5 text-[#D52B1E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
                    </svg>
                  )}
                  {sec.icon === 'target' && (
                    <svg class="h-3.5 w-3.5 text-[#D52B1E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
                    </svg>
                  )}
                  <span class="text-[11.5px] font-bold tracking-wider text-slate-900 dark:text-white group-hover:text-[#D52B1E] dark:group-hover:text-red-400 transition-colors uppercase">
                    {sec.label}
                  </span>
                </div>
                <p class="text-[10.5px] font-semibold text-[#D52B1E] dark:text-red-400 leading-tight truncate">
                  {sec.subtitle}
                </p>
              </a>

              <!-- Links List -->
              <div class="space-y-1 pt-2 border-t border-slate-100 dark:border-slate-800/80">
                {sec.items.map((item) => (
                  <a
                    href={item.path}
                    class="group flex items-center justify-between py-1 px-1 rounded-md text-[12px] font-medium text-slate-600 dark:text-slate-300 hover:text-[#D52B1E] dark:hover:text-red-400 hover:bg-slate-50 dark:hover:bg-slate-900/60 transition-all"
                  >
                    <span>{item.label}</span>
                    <span class="text-[10px] text-slate-300 group-hover:text-[#D52B1E] dark:text-slate-600 dark:group-hover:text-red-400 group-hover:translate-x-0.5 transition-all">
                      →
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Apple-grade Bottom Intelligence Action Strip -->
        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/90 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-[#D52B1E] dark:bg-red-950/70 dark:text-red-400 border border-red-200/80 dark:border-red-900/50 uppercase tracking-wider">
              SWISS RADAR ACTIVE
            </span>
            <span class="text-slate-500 dark:text-slate-400 text-[11px]">
              SOGC / SHAB Official Gazette Real-time Synchronization Active • All 26 Cantons
            </span>
          </div>
