---
// emdash-site/src/components/Navbar.astro
interface Props {
  currentLocale?: string;
}

const { currentLocale = "en" } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', path: '/' },
  { label: 'News & Reports', path: '/news' },
  { label: 'Companies', path: '/unternehmen' },
  { label: 'CEO Interviews', path: '/interviews' },
  { label: 'Careers', path: '/karriere' },
  { label: 'Market Rankings', path: '/ranking' },
  { label: 'Statistics', path: '/statistiken' },
];

const tickers = [
  { label: 'SMI', val: "12'123.42", chg: '+0.45%', up: true },
  { label: 'EUR/CHF', val: '0.9431', chg: '+0.18%', up: true },
  { label: 'USD/CHF', val: '0.8742', chg: '+0.21%', up: true },
  { label: 'S&P 500', val: "5'344.16", chg: '-0.31%', up: false },
  { label: 'Gold (oz)', val: '$2,345.10', chg: '+0.35%', up: true },
];

const languages = [
  { code: 'en', label: 'EN' },
  { code: 'de', label: 'DE' },
  { code: 'fr', label: 'FR' },
  { code: 'ar', label: 'عربي' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-slate-950/95 backdrop-blur-md shadow-xs transition-colors">
  <!-- 1. Google Material 3 Main Navigation Bar -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4 md:gap-6">
      
      <!-- Left: Brand Logo -->
      <div class="flex items-center shrink-0">
        <a href="/" class="group flex items-center gap-2 focus:outline-none" aria-label="PrivateSector.ch Home">
          <img 
            src="/logo.png" 
            alt="PrivateSector.ch" 
            class="h-8 md:h-9 w-auto object-contain transition-transform group-hover:scale-[1.02] dark:brightness-0 dark:invert" 
          />
        </a>
      </div>

      <!-- Center: Prominent Google-Style Pill Search Input -->
      <div class="flex flex-1 max-w-lg mx-auto">
        <form action="/news" method="GET" class="w-full relative group">
          <div class="relative flex items-center">
            <svg 
              class="pointer-events-none absolute left-4 h-4 w-4 text-slate-400 transition group-focus-within:text-[#D52B1E]" 
              xmlns="http://www.w3.org/2000/svg" 
              viewBox="0 0 20 20" 
              fill="currentColor"
            >
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
            <input
              type="text"
              name="search"
              placeholder="Search Swiss intelligence, enterprises, cantons..."
              class="w-full rounded-full border border-slate-200/90 bg-slate-50/80 py-2 pl-11 pr-12 text-sm text-slate-900 shadow-inner-sm transition-all outline-none placeholder:text-slate-400 focus:border-[#D52B1E]/60 focus:bg-white focus:ring-4 focus:ring-red-500/10 dark:border-slate-800 dark:bg-slate-900/80 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-red-500 dark:focus:bg-slate-900 dark:focus:ring-red-950/40"
            />
            <span class="pointer-events-none absolute right-3.5 hidden rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 sm:inline-block dark:border-slate-700 dark:bg-slate-800 dark:text-slate-500">
              ↵
            </span>
          </div>
        </form>
      </div>

      <!-- Right: Utility Controls (Theme, Language, Admin, Mobile Toggle) -->
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle Color Theme"
          class="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white focus:outline-none"
        >
          <svg id="theme-moon" class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg id="theme-sun" class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>

        <!-- Language Dropdown -->
        <div class="relative">
          <button
            id="lang-menu-btn"
            type="button"
            class="flex items-center gap-1 rounded-full border border-slate-200/90 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 focus:outline-none"
          >
            <span>{currentLocale.toUpperCase()}</span>
            <svg class="h-3 w-3 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="lang-menu-dropdown"
            class="absolute right-0 mt-2 hidden w-28 rounded-2xl border border-slate-200 bg-white py-1.5 shadow-lg backdrop-blur-md dark:border-slate-800 dark:bg-slate-900 z-50"
          >
            {languages.map((l) => (
              <a
                href={`?locale=${l.code}`}
                class={`block px-3 py-1.5 text-xs transition ${
                  currentLocale === l.code
                    ? 'font-bold text-[#D52B1E] bg-red-50/60 dark:bg-red-950/40 dark:text-red-400'
                    : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'
                }`}
              >
                {l.label} ({l.code.toUpperCase()})
              </a>
            ))}
          </div>
        </div>

        <!-- Sleek Admin Button -->
        <a
          href="/admin"
          class="hidden sm:inline-flex items-center justify-center rounded-full bg-[#D52B1E] px-4 py-1.5 text-xs font-bold text-white shadow-xs transition hover:bg-red-700 hover:shadow-sm"
        >
          Admin
        </a>

        <!-- Mobile Drawer Toggle -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Open mobile navigation menu"
          class="flex lg:hidden h-9 w-9 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 focus:outline-none"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- 2. Streamlined Navigation Tabs Bar (Google M3 Expressive Tabs) -->
  <div class="border-t border-slate-100 bg-white/70 dark:border-slate-850 dark:bg-slate-950/70">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="hidden lg:flex items-center gap-1 overflow-x-auto py-1.5 no-scrollbar">
        {navItems.map((item) => {
          const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
          return (
            <a
              href={item.path}
              class={`rounded-full px-4 py-1.5 text-xs font-medium transition-all ${
                isActive
                  ? 'bg-slate-900 text-white font-semibold dark:bg-slate-100 dark:!text-slate-950 shadow-xs'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-900 dark:hover:text-white'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <!-- 3. Super-Subtle Ultra-Thin Single-Line Ticker (Pinned Below Navigation) -->
  <div class="border-t border-b border-slate-200/60 bg-slate-50/90 py-1 px-4 text-[11px] text-slate-600 backdrop-blur-xs dark:border-slate-800/60 dark:bg-slate-900/80 dark:text-slate-400">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 overflow-x-auto no-scrollbar">
      <div class="flex items-center gap-2 shrink-0">
        <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.2 text-[9px] font-bold tracking-wider text-[#D52B1E] uppercase dark:bg-red-950/60 dark:text-red-400">
          SWISS RADAR
        </span>
        <span class="font-mono text-[10px] text-slate-400" id="zurich-clock">
          Zurich CET
        </span>
      </div>

      <div class="flex items-center gap-6 shrink-0 font-mono text-[10.5px]">
        {tickers.map((t) => (
          <div class="flex items-center gap-1.5">
            <span class="text-slate-400">{t.label}</span>
            <span class="font-semibold text-slate-900 dark:text-slate-200">{t.val}</span>
            <span class={t.up ? "text-emerald-600 dark:text-emerald-400 font-bold" : "text-rose-600 dark:text-rose-400 font-bold"}>
              {t.chg}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden border-b border-slate-200 bg-white px-4 py-5 shadow-lg lg:hidden dark:border-slate-800 dark:bg-slate-950">
    <div class="space-y-1.5">
      {navItems.map((item) => (
        <a
          href={item.path}
          class="block rounded-xl px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-900 dark:hover:text-white"
        >
          {item.label}
        </a>
      ))}
      <div class="mt-4 border-t border-slate-100 pt-3 dark:border-slate-800">
        <a
          href="/admin"
          class="flex w-full items-center justify-center rounded-full bg-[#D52B1E] py-2.5 text-xs font-bold text-white shadow-xs"
        >
          ⚡ Open EmDash Admin
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Live Zurich Clock
  function updateZurichTime() {
    const el = document.getElementById('zurich-clock');
    if (!el) return;
    try {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-GB', {
        timeZone: 'Europe/Zurich',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      });
      el.textContent = `Zurich ${timeStr} CET`;
    } catch (e) {
      el.textContent = 'Zurich CET';
    }
  }
  updateZurichTime();
  setInterval(updateZurichTime, 1000);

  // Theme Toggle Logic
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('ps_theme', isDark ? 'dark' : 'light');
    });
  }

  // Language Menu Dropdown
  const langBtn = document.getElementById('lang-menu-btn');
  const langDropdown = document.getElementById('lang-menu-dropdown');
  if (langBtn && langDropdown) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      langDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', () => {
      langDropdown.classList.add('hidden');
    });
  }

  // Mobile Menu Drawer
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });
  }
</script>
