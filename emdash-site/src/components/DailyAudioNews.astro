---
// emdash-site/src/components/DailyAudioNews.astro
import { getActiveMorningBriefings } from "../lib/legacy-db";

const briefings = await getActiveMorningBriefings(1);
const briefing = briefings.length > 0 ? briefings[0] : null;

const articles: any[] = briefing?.articles || [];
---

{briefing && (
  <section class="my-6">
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-shadow">
      
      <!-- Top Meta Strip -->
      <div class="bg-slate-950 text-white px-5 py-3 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#D52B1E] text-white tracking-wider uppercase">
            <span>🎙️</span>
            <span>MORNING BRIEFING</span>
          </span>
          <span class="text-xs text-slate-400 font-medium">
            {briefing.date}
          </span>
        </div>

        {briefing.audio_duration > 0 && (
          <span class="text-xs text-slate-400 font-medium tabular-nums flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
              <polyline points="12 6 12 12 16 14" stroke-width="2"></polyline>
            </svg>
            <span>~{Math.round(briefing.audio_duration / 60)} min audio edition</span>
          </span>
        )}
      </div>

      <!-- Main Audio & Briefing Content -->
      <div class="p-5 sm:p-6 lg:p-7">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          
          {briefing.image_url && (
            <div class="md:col-span-4 lg:col-span-3">
              <div class="aspect-video md:aspect-square w-full rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80 shadow-xs">
                <img 
                  src={briefing.image_url} 
                  alt={briefing.title} 
                  class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                  onerror="this.src='/logo.png'"
                />
              </div>
            </div>
          )}

          <div class={briefing.image_url ? "md:col-span-8 lg:col-span-9 space-y-4" : "md:col-span-12 space-y-4"}>
            <div>
              <span class="text-xs font-semibold text-red-600 dark:text-red-400 uppercase tracking-wider">
                Daily Swiss Market Podcast
              </span>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white mt-1">
                {briefing.title}
              </h2>
            </div>

            <!-- Native Audio Player with Styling -->
            {briefing.audio_url && (
              <div class="bg-slate-50 dark:bg-slate-800/60 p-3 rounded-xl border border-slate-200/80 dark:border-slate-700/60 flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                  <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <audio 
                    controls 
                    src={briefing.audio_url} 
                    transition:persist="morning-briefing-audio" 
                    class="w-full h-9 rounded-lg"
                  ></audio>
                </div>
              </div>
            )}

            <!-- Transcript Accordion -->
            <details class="group border border-slate-200/80 dark:border-slate-800 rounded-xl overflow-hidden">
              <summary class="px-4 py-2.5 bg-slate-50 dark:bg-slate-800/40 cursor-pointer font-semibold text-xs text-slate-700 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-400 transition-colors flex items-center justify-between select-none">
                <span class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-width="2"></path>
                    <polyline points="14 2 14 8 20 8" stroke-width="2"></polyline>
                  </svg>
                  <span>Read Briefing Transcript</span>
                </span>
                <span class="text-xs transition-transform group-open:rotate-180">▼</span>
              </summary>
              <div class="p-4 bg-white dark:bg-slate-900 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-h-48 overflow-y-auto whitespace-pre-wrap border-t border-slate-100 dark:border-slate-800">
                {briefing.transcript || "In this morning briefing, PrivateSector covers today's key commercial updates across Switzerland and foreign direct investment corridors."}
              </div>
            </details>
          </div>

        </div>

        <!-- Featured Articles Covered in this Briefing -->
        {articles.length > 0 && (
          <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800">
            <h4 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-3">
              Included In Today's Briefing ({articles.length})
            </h4>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {articles.map((art: any, idx: number) => (
                <a 
                  href={`/news/${art.slug || art.id}`}
                  class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 hover:border-red-500/50 transition-all group"
                >
                  <span class="w-6 h-6 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold flex items-center justify-center shrink-0">
                    {idx + 1}
                  </span>
                  {art.image_url && (
                    <img 
                      src={art.image_url} 
                      alt="" 
                      class="w-10 h-10 rounded-lg object-cover shrink-0" 
                      onerror="this.style.display='none'" 
                    />
                  )}
                  <div class="min-w-0 flex-1">
                    <span class="text-[10px] font-bold text-red-600 dark:text-red-400 uppercase block truncate">
                      {art.category || 'MARKETS'}
                    </span>
                    <span class="text-xs font-medium text-slate-800 dark:text-slate-200 truncate block group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">
                      {art.title}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </section>
)}
