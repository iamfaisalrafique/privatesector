---
// emdash-site/src/components/DailyAudioNews.astro
import { getActiveMorningBriefings } from "../lib/legacy-db";

const briefings = getActiveMorningBriefings(1);
const briefing = briefings.length > 0 ? briefings[0] : null;

const articles: any[] = briefing?.articles || [];
---

{briefing && (
  <div class="daily-audio-news-container" style="margin-top: 16px; margin-bottom: 24px;">
    <div style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
      
      <!-- Top Status Header -->
      <div style="background-color: #0F172A; color: #FFFFFF; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="background-color: #D52B1E; color: #FFFFFF; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 3px; letter-spacing: 0.08em; text-transform: uppercase;">
            AUDIO BRIEFING
          </span>
          <span style="font-size: 12px; color: #94A3B8;">
            📅 {briefing.date}
          </span>
        </div>

        {briefing.audio_duration > 0 && (
          <span style="font-size: 11px; color: #94A3B8; font-weight: 600;">
            ⏱️ ~{Math.round(briefing.audio_duration / 60)} min audio
          </span>
        )}
      </div>

      <!-- Main Card Body -->
      <div style="padding: 24px;">
        <div style="display: grid; grid-template-columns: minmax(280px, 340px) 1fr; gap: 24px; align-items: start;" class="briefing-grid">
          
          {briefing.image_url && (
            <div style="width: 100%; height: 200px; border-radius: 8px; overflow: hidden; border: 1px solid #E2E8F0;">
              <img 
                src={briefing.image_url} 
                alt={briefing.title} 
                style="width: 100%; height: 100%; object-fit: cover;"
                onerror="this.src='/logo.png'"
              />
            </div>
          )}

          <div>
            <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; line-height: 1.3; font-weight: 700; color: #0F172A; margin: 0 0 16px 0;">
              {briefing.title}
            </h3>

            <!-- Audio Player -->
            {briefing.audio_url && (
              <div style="margin-bottom: 16px;">
                <audio controls src={briefing.audio_url} transition:persist="morning-briefing-audio" style="width: 100%; height: 40px; border-radius: 20px; outline: none;"></audio>
              </div>
            )}

            <!-- Transcript Drawer Button -->
            <details style="margin-top: 12px; cursor: pointer;">
              <summary style="font-size: 13px; font-weight: 600; color: #D52B1E; user-select: none;">
                📄 Read Audio Transcript
              </summary>
              <div style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; padding: 14px 16px; font-size: 13.5px; line-height: 1.7; color: #334155; margin-top: 8px; max-height: 180px; overflow-y: auto; white-space: pre-wrap;">
                {briefing.transcript || "In this morning briefing, PrivateSector covers today's key commercial updates across Switzerland and foreign direct investment corridors."}
              </div>
            </details>
          </div>

        </div>

        <!-- Stories Covered in Briefing -->
        {articles.length > 0 && (
          <div style="border-top: 1px solid #E2E8F0; padding-top: 16px; margin-top: 20px;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #64748B; margin-bottom: 10px;">
              Stories Covered in this Briefing ({articles.length})
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px;">
              {articles.map((art: any, idx: number) => (
                <a 
                  href={`/news/${art.slug || art.id}`}
                  style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 6px; background-color: #F8FAFC; text-decoration: none; border: 1px solid #E2E8F0; transition: border-color 0.15s ease;"
                  onmouseover="this.style.borderColor='#D52B1E'"
                  onmouseout="this.style.borderColor='#E2E8F0'"
                >
                  <span style="width: 22px; height: 22px; border-radius: 50%; background-color: #E2E8F0; color: #0F172A; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    {idx + 1}
                  </span>
                  {art.image_url && (
                    <img src={art.image_url} alt="" style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover; flex-shrink: 0;" onerror="this.style.display='none'" />
                  )}
                  <div style="flex: 1; min-width: 0;">
                    <div style="font-size: 10px; font-weight: 700; color: #D52B1E; text-transform: uppercase;">
                      {art.category || 'News'}
                    </div>
                    <div style="font-size: 12.5px; font-weight: 600; color: #0F172A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      {art.title}
                    </div>
                  </div>
                  <span style="color: #94A3B8;">→</span>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </div>
)}

<style>
  @media (max-width: 768px) {
    .briefing-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
