---
// emdash-site/src/pages/404.astro
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found | PrivateSector.ch" description="The requested page could not be located on PrivateSector.ch.">
  <div class="flex min-h-[calc(100vh-200px)] flex-col items-center justify-center px-4 py-20 text-center sm:px-6">
    <div class="relative">
      <span class="text-8xl font-black tracking-tight text-slate-100 sm:text-9xl dark:text-slate-800/80">
        404
      </span>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="rounded-full bg-red-50 px-4 py-1.5 text-xs font-bold tracking-widest text-[#D52B1E] uppercase dark:bg-red-950/60 dark:text-red-400">
          PAGE NOT FOUND
        </span>
      </div>
    </div>

    <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
      Page not found
    </h1>
    <p class="mt-3 max-w-md text-sm text-slate-600 sm:text-base dark:text-slate-400">
      The page you're looking for doesn't exist or has moved to a new canonical URL.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 rounded-full bg-[#0F172A] px-6 py-3 text-sm font-bold text-white shadow-xs transition hover:bg-slate-800 hover:shadow-md dark:bg-red-600 dark:hover:bg-red-500"
      >
        <span>←</span> Go home
      </a>
      <a 
        href="/news" 
        class="inline-flex items-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-800 shadow-xs transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
      >
        Browse News Archive
      </a>
    </div>
  </div>
</Base>
