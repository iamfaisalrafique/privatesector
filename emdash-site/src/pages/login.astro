---
// emdash-site/src/pages/login.astro
import Base from "../layouts/Base.astro";
---

<Base title="Sign In & Member Access | PrivateSector.ch" description="Member and administrator access to PrivateSector.ch business intelligence and directory administration.">
  <div class="flex min-h-[calc(100vh-130px)] flex-col lg:flex-row">
    
    <!-- Left Hero Brand Column -->
    <div class="relative flex flex-1 flex-col justify-between overflow-hidden bg-[#070A12] p-8 text-white sm:p-12 lg:p-16">
      <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-red-600/15 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-blue-600/10 blur-3xl"></div>

      <div class="relative z-10 my-auto max-w-md">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-950/40 px-3 py-1 text-[11px] font-bold tracking-widest text-red-400 uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
          ACCESS PORTAL
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
          Swiss Economic Intelligence, <span class="text-[#D52B1E] italic">Fully Verified.</span>
        </h2>
        
        <div class="mt-10 space-y-6">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-red-500/10 font-bold text-[#D52B1E] border border-red-500/20">
              ✓
            </div>
            <div>
              <strong class="block text-sm font-semibold text-white">Verified B2B Corporate Dossiers</strong>
              <p class="mt-0.5 text-xs text-slate-400">Metrics, cantonal, and commercial register data directly from official sources.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-red-500/10 font-bold text-[#D52B1E] border border-red-500/20">
              🛡️
            </div>
            <div>
              <strong class="block text-sm font-semibold text-white">Precise Analysis & Market Reports</strong>
              <p class="mt-0.5 text-xs text-slate-400">Independent business journalism with exclusive CEO and executive interviews.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-red-500/10 font-bold text-[#D52B1E] border border-red-500/20">
              🔒
            </div>
            <div>
              <strong class="block text-sm font-semibold text-white">100% GDPR & Swiss FADP Compliant</strong>
              <p class="mt-0.5 text-xs text-slate-400">Your preferences and data are hosted completely encrypted in Switzerland.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative z-10 mt-8 flex flex-wrap items-center gap-3 border-t border-slate-800/80 pt-6 text-xs text-slate-400">
        <span>Swiss-made 🇨🇭</span>
        <span>·</span>
        <span>GDPR & Swiss Data Protection Act compliant</span>
        <span>·</span>
        <span>PrivateSector Intelligence</span>
      </div>
    </div>

    <!-- Right Login Column -->
    <div class="flex flex-1 flex-col items-center justify-center bg-white p-8 dark:bg-[#0B0F19] sm:p-12 lg:p-16">
      <div class="w-full max-w-sm space-y-6">
        
        <div class="text-center">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
            Sign In
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Welcome back to the Swiss Business Intelligence Portal
          </p>
        </div>

        <!-- Feedback Alert Box -->
        <div id="login-feedback" class="hidden rounded-2xl p-4 text-xs font-semibold border"></div>

        <!-- Login Form -->
        <form id="login-form" class="space-y-5">
          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-700 uppercase dark:text-slate-300">
              Email Address
            </label>
            <input 
              type="email" 
              id="login-email" 
              required 
              placeholder="admin@privatesector.ch" 
              class="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50/50 px-4 py-3.5 text-sm text-slate-900 transition outline-none focus:border-[#D52B1E] focus:bg-white focus:ring-2 focus:ring-red-100 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:border-red-500 dark:focus:ring-red-950/40"
            />
          </div>

          <div>
            <div class="flex items-center justify-between">
              <label class="block text-xs font-semibold tracking-wider text-slate-700 uppercase dark:text-slate-300">
                Password
              </label>
            </div>
            <input 
              type="password" 
              id="login-password" 
              required 
              placeholder="••••••••••••" 
              class="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50/50 px-4 py-3.5 text-sm text-slate-900 transition outline-none focus:border-[#D52B1E] focus:bg-white focus:ring-2 focus:ring-red-100 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:border-red-500 dark:focus:ring-red-950/40"
            />
          </div>

          <button 
            type="submit" 
            id="login-submit-btn"
            class="w-full rounded-full bg-slate-900 dark:bg-[#D52B1E] py-4 text-sm font-bold text-white shadow-xs transition-all hover:bg-slate-800 dark:hover:bg-red-700 hover:scale-102"
          >
            Sign In →
          </button>
        </form>

        <div class="border-t border-slate-200/80 pt-6 text-center dark:border-slate-800/80">
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Administrator or Editorial Team?
          </p>
          <a 
            href="/_emdash/api/auth/dev-bypass?redirect=/_emdash/admin"
            class="mt-3 inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-3.5 text-xs font-semibold text-slate-800 shadow-xs transition hover:bg-slate-50 dark:border-slate-700 dark:bg-[#0E1524] dark:text-slate-200 dark:hover:bg-slate-800"
          >
            ⚡ Open EmDash CMS Dashboard (Direct Access) →
          </a>
        </div>

      </div>
    </div>

  </div>

  <script is:inline data-astro-rerun>
    const form = document.getElementById('login-form');
    const feedback = document.getElementById('login-feedback');
    const submitBtn = document.getElementById('login-submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-email').value.trim();
        const password = document.getElementById('login-password').value;

        if (!email || !password) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Verifying...';
        feedback.classList.add('hidden');

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();

          if (!res.ok) {
            feedback.className = 'mt-6 rounded-xl p-4 text-xs font-semibold bg-red-50 text-red-700 border border-red-200 dark:bg-red-950/50 dark:text-red-400 dark:border-red-900/50';
            feedback.textContent = data.error || 'Invalid email or password.';
            feedback.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Sign In →';
            return;
          }

          if (data.success && data.user) {
            localStorage.setItem('userSession', JSON.stringify(data.user));
            feedback.className = 'mt-6 rounded-xl p-4 text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-400 dark:border-emerald-900/50';
            feedback.textContent = 'Successfully signed in. Redirecting...';
            feedback.classList.remove('hidden');

            setTimeout(() => {
              if (data.user.role === 'admin') {
                window.location.href = '/admin';
              } else {
                window.location.href = '/';
              }
            }, 500);
          }
        } catch (err) {
          feedback.className = 'mt-6 rounded-xl p-4 text-xs font-semibold bg-red-50 text-red-700 border border-red-200 dark:bg-red-950/50 dark:text-red-400 dark:border-red-900/50';
          feedback.textContent = 'Connection error. Please try again.';
          feedback.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Sign In →';
        }
      });
    }
  </script>
</Base>
