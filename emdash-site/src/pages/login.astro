---
// emdash-site/src/pages/login.astro
import Base from "../layouts/Base.astro";
---

<Base title="Login & Member Access | PrivateSector.ch" description="Member and administrator access to PrivateSector.ch business intelligence and directory administration.">
  <div style="display: flex; min-height: calc(100vh - 110px); background-color: var(--bg-ivory, #FFFFFF);" class="auth-split-screen">
    
    <!-- Left 50% Panel - Dark #0A0A0A -->
    <div 
      style="flex: 1; background-color: #0A0A0A; color: #FFFDF7; padding: 64px; display: flex; flex-direction: column; justify-content: space-between; position: relative;"
      class="auth-left-col"
    >
      <div style="max-width: 440px; margin: 40px 0;">
        <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 36px; font-weight: 700; line-height: 1.3; margin-bottom: 24px; color: #FFFDF7;">
          Schweizer Wirtschaftsdaten, <span style="color: #D52B1E; font-style: italic;">vollständig verifiziert.</span>
        </h2>
        
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <div style="display: flex; gap: 16px; align-items: flex-start;">
            <div style="width: 28px; height: 28px; border-radius: 50%; background-color: rgba(213, 43, 30, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #D52B1E; font-weight: bold;">
              ✓
            </div>
            <div>
              <strong style="display: block; font-size: 14px; color: #FFFDF7; margin-bottom: 2px;">Verifizierte B2B-Firmendossiers</strong>
              <span style="font-size: 12px; color: #9CA3AF;">Metriken, Kantons- und Registerdaten direkt aus offiziellen Quellen.</span>
            </div>
          </div>

          <div style="display: flex; gap: 16px; align-items: flex-start;">
            <div style="width: 28px; height: 28px; border-radius: 50%; background-color: rgba(213, 43, 30, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #D52B1E; font-weight: bold;">
              🛡️
            </div>
            <div>
              <strong style="display: block; font-size: 14px; color: #FFFDF7; margin-bottom: 2px;">Präzise Analysen & Marktberichte</strong>
              <span style="font-size: 12px; color: #9CA3AF;">Unabhängiger Wirtschaftsjournalismus mit exklusiven CEO-Interviews.</span>
            </div>
          </div>

          <div style="display: flex; gap: 16px; align-items: flex-start;">
            <div style="width: 28px; height: 28px; border-radius: 50%; background-color: rgba(213, 43, 30, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #D52B1E; font-weight: bold;">
              🔒
            </div>
            <div>
              <strong style="display: block; font-size: 14px; color: #FFFDF7; margin-bottom: 2px;">100% DSGVO / GDPR Konformität</strong>
              <span style="font-size: 12px; color: #9CA3AF;">Ihre Präferenzen und Daten werden vollständig verschlüsselt in der Schweiz gehostet.</span>
            </div>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 12px; font-size: 11px; color: #6B7280; border-top: 0.5px solid #2A2A2A; padding-top: 16px;">
        <span>Swiss-made 🇨🇭</span>
        <span>·</span>
        <span>GDPR & FADP compliant</span>
        <span>·</span>
        <span>PrivateSector Intelligence</span>
      </div>
    </div>

    <!-- Right 50% Panel - Ivory Form -->
    <div 
      style="flex: 1; padding: 64px 32px; display: flex; flex-direction: column; justify-content: center; align-items: center;"
      class="auth-right-col"
    >
      <div style="width: 100%; maxWidth: 400px;">
        
        <div style="text-align: center; margin-bottom: 24px;">
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 32px; font-weight: 700; color: #0A0A0A; margin: 0 0 8px;">
            Anmelden
          </h2>
          <p style="font-size: 13px; color: #4B5563; margin: 0;">
            Willkommen zurück im Schweizer B2B Portal
          </p>
        </div>

        <!-- Feedback Alert Box -->
        <div id="login-feedback" style="display: none; padding: 12px 16px; border-radius: 6px; font-size: 13px; margin-bottom: 16px;"></div>

        <!-- Login Form -->
        <form id="login-form" style="display: flex; flex-direction: column; gap: 16px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: #111827;">
              E-Mail Adresse
            </label>
            <input 
              type="email" 
              id="login-email" 
              required 
              placeholder="admin@private.com" 
              style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 14px; font-family: Inter, sans-serif; outline: none; box-sizing: border-box;"
            />
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <label style="font-size: 12px; font-weight: 600; color: #111827;">
                Passwort
              </label>
            </div>
            <input 
              type="password" 
              id="login-password" 
              required 
              placeholder="••••••••••••" 
              style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 14px; font-family: Inter, sans-serif; outline: none; box-sizing: border-box;"
            />
          </div>

          <button 
            type="submit" 
            id="login-submit-btn"
            style="width: 100%; padding: 12px; background-color: #0A0A0A; color: #FFFDF7; border: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: background-color 150ms ease;"
          >
            Anmelden →
          </button>
        </form>

        <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #E5E7EB; text-align: center;">
          <p style="font-size: 12px; color: #6B7280; margin-bottom: 10px;">
            Administrator oder Redaktion?
          </p>
          <a 
            href="/_emdash/admin"
            style="display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: #D52B1E; text-decoration: none;"
          >
            Direkt zum EmDash CMS (/_emdash/admin) →
          </a>
        </div>

      </div>
    </div>

  </div>

  <style>
    @media (max-width: 840px) {
      .auth-split-screen {
        flex-direction: column !important;
      }
      .auth-left-col {
        display: none !important;
      }
      .auth-right-col {
        padding: 40px 20px !important;
      }
    }
  </style>

  <script is:inline data-astro-rerun>
    const form = document.getElementById('login-form');
    const feedback = document.getElementById('login-feedback');
    const submitBtn = document.getElementById('login-submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-email').value.trim();
        const password = document.getElementById('login-password').value;

        if (!email || !password) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Verifiziere...';
        feedback.style.display = 'none';

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();

          if (!res.ok) {
            feedback.style.display = 'block';
            feedback.style.backgroundColor = '#FEE2E2';
            feedback.style.color = '#B91C1C';
            feedback.style.border = '1px solid #FCA5A5';
            feedback.textContent = data.error || 'Ungültige Anmeldedaten.';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Anmelden →';
            return;
          }

          if (data.success && data.user) {
            localStorage.setItem('userSession', JSON.stringify(data.user));
            feedback.style.display = 'block';
            feedback.style.backgroundColor = '#ECFDF5';
            feedback.style.color = '#047857';
            feedback.style.border = '1px solid #6EE7B7';
            feedback.textContent = 'Erfolgreich angemeldet. Weiterleitung...';

            setTimeout(() => {
              if (data.user.role === 'admin') {
                window.location.href = '/admin';
              } else {
                window.location.href = '/';
              }
            }, 500);
          }
        } catch (err) {
          feedback.style.display = 'block';
          feedback.style.backgroundColor = '#FEE2E2';
          feedback.style.color = '#B91C1C';
          feedback.textContent = 'Verbindungsfehler. Bitte versuchen Sie es erneut.';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Anmelden →';
        }
      });
    }
  </script>
</Base>
