---
// emdash-site/src/pages/contact.astro
import Base from "../layouts/Base.astro";
---

<Base 
  title="Contact the Editorial Desk & Bureau — PrivateSector.ch"
  description="Get in touch with the PrivateSector editorial bureau, directory team, or transatlantic commercial desks."
>
  <div style="background-color: #FFFFFF; border-bottom: 1px solid #E5E7EB; padding: 48px 24px;">
    <div style="max-width: 900px; margin: 0 auto;">
      <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #D52B1E; display: block; margin-bottom: 8px;">
        COMMUNICATIONS & EDITORIAL
      </span>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 38px; font-weight: 700; color: #000000; margin: 0 0 16px 0;">
        Contact the Editorial Desk
      </h1>
      <p style="font-size: 17px; line-height: 1.6; color: #4B5563; margin: 0;">
        For commercial inquiries, directory corrections, executive interviews, or press releases, submit your request directly to our Zurich editorial team.
      </p>
    </div>
  </div>

  <main style="max-width: 900px; margin: 0 auto; padding: 48px 24px 96px; font-family: Inter, sans-serif;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px;">
      
      <!-- Contact Form -->
      <div style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 32px;">
        <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; margin: 0 0 20px 0;">
          Direct Inquiries
        </h2>

        <form action="#" method="POST" onsubmit="event.preventDefault(); alert('Thank you. Your message has been routed to the PrivateSector editorial bureau.');">
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px; text-transform: uppercase;">
              Full Name *
            </label>
            <input 
              type="text" 
              required
              placeholder="e.g. Dr. Thomas Meyer"
              style="width: 100%; padding: 10px 14px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 14px; outline: none; box-sizing: border-box;"
            />
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px; text-transform: uppercase;">
              Organization / Company
            </label>
            <input 
              type="text" 
              placeholder="e.g. Meyer Capital Partners AG"
              style="width: 100%; padding: 10px 14px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 14px; outline: none; box-sizing: border-box;"
            />
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px; text-transform: uppercase;">
              Business Email *
            </label>
            <input 
              type="email" 
              required
              placeholder="t.meyer@example.ch"
              style="width: 100%; padding: 10px 14px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 14px; outline: none; box-sizing: border-box;"
            />
          </div>

          <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px; text-transform: uppercase;">
              Message / Inquiries *
            </label>
            <textarea 
              rows="4"
              required
              placeholder="Detail your inquiry, press release, or directory update..."
              style="width: 100%; padding: 10px 14px; border: 1px solid #D1D5DB; border-radius: 6px; font-size: 14px; outline: none; box-sizing: border-box; resize: vertical;"
            ></textarea>
          </div>

          <button 
            type="submit"
            style="width: 100%; background-color: #D52B1E; color: #FFFFFF; border: none; border-radius: 6px; padding: 12px 20px; font-size: 14px; font-weight: 700; cursor: pointer;"
          >
            Submit to Bureau Desk →
          </button>
        </form>
      </div>

      <!-- Bureau Coordinates -->
      <div>
        <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 32px; margin-bottom: 24px;">
          <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 700; margin: 0 0 16px 0;">
            Zurich Headquarters
          </h3>
          <p style="font-size: 14px; color: #4B5563; line-height: 1.6; margin: 0 0 16px 0;">
            PrivateSector Media & Commercial Intelligence<br />
            Gotthardstrasse, 8002 Zürich<br />
            Switzerland 🇨🇭
          </p>
          <div style="font-size: 13px; color: #6B7280; display: flex; flex-direction: column; gap: 8px;">
            <span>✉️ <strong>General:</strong> info@privatesector.ch</span>
            <span>📰 <strong>Editorial:</strong> editorial@privatesector.ch</span>
            <span>🛡️ <strong>Registry Desk:</strong> verify@privatesector.ch</span>
          </div>
        </div>

        <div style="border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px;">
          <h4 style="font-size: 14px; font-weight: 700; margin: 0 0 8px 0;">
            Editorial Standards
          </h4>
          <p style="font-size: 12.5px; color: #6B7280; line-height: 1.6; margin: 0;">
            We operate in strict adherence to Swiss privacy legislation (FADP/DSG) and GDPR. All reported commercial data is reconciled against statutory disclosures.
          </p>
        </div>
      </div>

    </div>
  </main>
</Base>
