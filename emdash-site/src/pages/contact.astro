---
// emdash-site/src/pages/contact.astro
import Base from "../layouts/Base.astro";
---

<Base 
  title="Contact the Editorial Desk & Bureau — PrivateSector.ch"
  description="Get in touch with the PrivateSector editorial bureau, directory team, or transatlantic commercial desks."
>
  <!-- Header Banner -->
  <section class="border-b border-slate-200/80 bg-white dark:border-slate-800/80 dark:bg-[#0B0F19] py-14 sm:py-20 transition-colors">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-red-200/60 bg-red-50 dark:border-red-900/40 dark:bg-red-950/40 px-3.5 py-1 text-[11px] font-bold tracking-widest text-[#D52B1E] uppercase dark:text-red-400">
        <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
        COMMUNICATIONS & EDITORIAL
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
        Contact the Editorial Desk
      </h1>
      <p class="mt-4 max-w-3xl text-lg sm:text-xl leading-relaxed text-slate-600 dark:text-slate-300">
        For commercial inquiries, directory corrections, executive interviews, or press releases, submit your request directly to our Zurich editorial team.
      </p>
    </div>
  </section>

  <!-- Main Grid -->
  <main class="mx-auto max-w-5xl px-4 py-12 sm:py-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12">
      
      <!-- Contact Form -->
      <div class="rounded-3xl border border-slate-200/80 bg-white p-8 sm:p-10 shadow-xs dark:border-slate-800/80 dark:bg-[#0E1524] lg:col-span-7">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          Direct Inquiries
        </h2>

        <form id="contact-form" class="mt-8 space-y-6">
          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-700 uppercase dark:text-slate-300">
              Full Name *
            </label>
            <input 
              type="text" 
              required
              placeholder="e.g. Dr. Thomas Meyer"
              class="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 transition outline-none focus:border-[#D52B1E] focus:bg-white focus:ring-2 focus:ring-red-100 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:border-red-500 dark:focus:ring-red-950/40"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-700 uppercase dark:text-slate-300">
              Organization / Company
            </label>
            <input 
              type="text" 
              placeholder="e.g. Meyer Capital Partners AG"
              class="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 transition outline-none focus:border-[#D52B1E] focus:bg-white focus:ring-2 focus:ring-red-100 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:border-red-500 dark:focus:ring-red-950/40"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-700 uppercase dark:text-slate-300">
              Business Email *
            </label>
            <input 
              type="email" 
              required
              placeholder="t.meyer@example.ch"
              class="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 transition outline-none focus:border-[#D52B1E] focus:bg-white focus:ring-2 focus:ring-red-100 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:border-red-500 dark:focus:ring-red-950/40"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-700 uppercase dark:text-slate-300">
              Message / Inquiries *
            </label>
            <textarea 
              rows="5"
              required
              placeholder="Detail your inquiry, press release, or directory update..."
              class="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-slate-900 transition outline-none focus:border-[#D52B1E] focus:bg-white focus:ring-2 focus:ring-red-100 dark:border-slate-700 dark:bg-slate-800/50 dark:text-white dark:focus:border-red-500 dark:focus:ring-red-950/40"
            ></textarea>
          </div>

          <div id="contact-feedback" class="hidden rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 p-4 text-sm font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
            Thank you. Your message has been routed to the PrivateSector editorial bureau.
          </div>

          <button 
            type="submit"
            class="w-full rounded-full bg-slate-900 dark:bg-[#D52B1E] py-4 text-sm font-bold text-white shadow-xs transition-all hover:bg-slate-800 dark:hover:bg-red-700 hover:scale-102"
          >
            Submit to Bureau Desk →
          </button>
        </form>
      </div>

      <!-- Bureau Coordinates & Editorial Standards -->
      <div class="space-y-6 lg:col-span-5">
        <div class="rounded-3xl border border-slate-200/80 bg-white p-8 sm:p-10 shadow-xs dark:border-slate-800/80 dark:bg-[#0E1524]">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            Zurich Headquarters
          </h3>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            PrivateSector Media & Commercial Intelligence<br />
            Gotthardstrasse, 8002 Zürich<br />
            Switzerland 🇨🇭
          </p>
          <div class="mt-6 space-y-3.5 border-t border-slate-100 dark:border-slate-800/80 pt-6 text-sm text-slate-600 dark:text-slate-400">
            <div class="flex items-center gap-3">
              <span class="text-base">✉️</span>
              <span><strong>General:</strong> info@privatesector.ch</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-base">📰</span>
              <span><strong>Editorial:</strong> editorial@privatesector.ch</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-base">🛡️</span>
              <span><strong>Registry Desk:</strong> verify@privatesector.ch</span>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200/80 bg-slate-50/70 p-7 dark:border-slate-800/80 dark:bg-[#0E1524]/60">
          <h4 class="text-sm font-bold text-slate-900 dark:text-white">
            Editorial Standards
          </h4>
          <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            We operate in strict adherence to Swiss privacy legislation (FADP/DSG) and GDPR. All reported commercial data is reconciled against statutory disclosures.
          </p>
        </div>
      </div>

    </div>
  </main>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('contact-feedback');
    if (form && feedback) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        feedback.classList.remove('hidden');
        form.reset();
      });
    }
  </script>
</Base>
