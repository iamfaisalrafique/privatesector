---
// emdash-site/src/pages/index.astro
import Base from "../layouts/Base.astro";
import BreakingBanner from "../components/BreakingBanner.astro";
import DailyAudioNews from "../components/DailyAudioNews.astro";
import Hero from "../components/Hero.astro";
import NewsCard from "../components/NewsCard.astro";
import CompanyCard from "../components/CompanyCard.astro";
import HomepageGraphics from "../components/HomepageGraphics.astro";
import { getNews, getCompanies } from "../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";

// Fetch news and featured companies directly from native backend
const allNews = await getNews(13);
const leadStory = allNews[0];
const secondaryStories = allNews.slice(1, 4);
const gridNews = allNews.slice(4, 13);
const featuredCompanies = await getCompanies(true, 4);
---

<Base 
  title="privatesector.ch — Swiss Private Sector Business Platform"
  description="Switzerland's authoritative Private Sector Intelligence Platform. Daily morning briefings, verified Swiss B2B directory, and corporate market dossiers."
  locale={currentLocale}
>
  <!-- 1. Breaking News Red Ticker Banner -->
  <BreakingBanner />

  <!-- 2. Google Material 3 / Apple Modern Minimalist Hero -->
  <Hero />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 md:py-14 space-y-14 md:space-y-18">
    
    <!-- 3. Featured Editorial Intelligence Grid (Modern Minimalist Grid Lead) -->
    {leadStory && (
      <section>
        <div class="mb-6 flex items-center justify-between border-b border-slate-200/80 pb-4 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-3 py-0.5 text-[10px] font-bold tracking-wider text-[#D52B1E] uppercase dark:border-red-900/40 dark:bg-red-950/40 dark:text-red-400">
              <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
              TOP ANALYSIS
            </span>
            <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
              Executive Briefings & Market Spotlights
            </h2>
          </div>
          <a 
            href="/news" 
            class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-[#D52B1E] transition hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
          >
            <span>View All Intelligence</span>
            <span>→</span>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 items-stretch">
          <!-- Main Lead Story Showcase -->
          <div class="lg:col-span-7">
            <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
              <a href={`/news/${leadStory.slug || leadStory.id}`} class="relative block overflow-hidden bg-slate-100/60 dark:bg-slate-800/50 p-2 sm:p-2.5">
                {leadStory.image_url ? (
                  <div class="relative overflow-hidden rounded-2xl aspect-[16/9] bg-slate-900/5 dark:bg-slate-950/40">
                    <img 
                      src={leadStory.image_url} 
                      alt={leadStory.title} 
                      class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.01]"
                      onerror="this.src='/logo.png'"
                    />
                  </div>
                ) : (
                  <div class="flex aspect-[16/9] w-full items-center justify-center rounded-2xl bg-slate-100 text-xs font-bold text-slate-400 uppercase dark:bg-slate-800">
                    PrivateSector Intelligence
                  </div>
                )}
              </a>

              <div class="flex flex-1 flex-col justify-between p-7">
                <div class="space-y-3">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 dark:bg-red-950/80 px-2.5 py-0.5 text-[10px] font-bold tracking-wider text-[#D52B1E] dark:text-red-400 border border-red-200/80 dark:border-red-900/60 uppercase">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
                      {leadStory.category || 'LEAD STORY'}
                    </span>
                    {leadStory.date_published && (
                      <span class="font-mono text-[10px] text-slate-400">
                        {new Date(leadStory.date_published).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-snug transition-colors group-hover:text-[#D52B1E] dark:text-white dark:group-hover:text-red-400">
                    <a href={`/news/${leadStory.slug || leadStory.id}`}>
                      {leadStory.title}
                    </a>
                  </h3>
                  {leadStory.subtitle && (
                    <p class="text-sm leading-relaxed text-slate-600 line-clamp-3 dark:text-slate-300">
                      {leadStory.subtitle}
                    </p>
                  )}
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
                  <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">
                    By PrivateSector Editorial Desk
                  </span>
                  <a 
                    href={`/news/${leadStory.slug || leadStory.id}`} 
                    class="text-xs font-bold text-[#D52B1E] transition hover:underline dark:text-red-400"
                  >
                    Read Analysis →
                  </a>
                </div>
              </div>
            </article>
          </div>

          <!-- Secondary Story Stack (3 Cards with Dedicated Image Previews) -->
          <div class="flex flex-col gap-4 lg:col-span-5 justify-between">
            {secondaryStories.map((sec: any) => (
              <a 
                href={`/news/${sec.slug || sec.id}`}
                class="group flex flex-1 flex-col sm:flex-row items-start sm:items-center gap-4 rounded-3xl border border-slate-200/80 bg-white p-3.5 sm:p-4 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
              >
                <!-- Story Image Thumbnail (Fitted & Never Cropped) -->
                <div class="relative h-24 w-full sm:h-24 sm:w-28 shrink-0 overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-100 dark:border-slate-800">
                  <img 
                    src={sec.image_url || '/logo.png'} 
                    alt={sec.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.src='/logo.png'"
                  />
                </div>
                <div class="flex flex-1 flex-col justify-between self-stretch min-w-0 py-0.5">
                  <div>
                    <div class="mb-1.5 flex items-center gap-2">
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold tracking-wider text-slate-700 uppercase dark:bg-slate-800 dark:text-slate-300">
                        {sec.category || 'BRIEFING'}
                      </span>
                      {sec.date_published && (
                        <span class="font-mono text-[10px] text-slate-400">
                          {new Date(sec.date_published).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                        </span>
                      )}
                    </div>
                    <h4 class="text-sm font-bold text-slate-900 transition-colors group-hover:text-[#D52B1E] dark:text-white dark:group-hover:text-red-400 line-clamp-2">
                      {sec.title}
                    </h4>
                    {sec.subtitle && (
                      <p class="mt-1 text-xs text-slate-500 line-clamp-1 dark:text-slate-400">
                        {sec.subtitle}
                      </p>
                    )}
                  </div>
                  <div class="mt-2 flex items-center justify-end text-[11px] font-bold text-[#D52B1E] dark:text-red-400">
                    <span class="transition-transform group-hover:translate-x-1">Explore →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 4. Daily Audio Briefing (Apple Podcast Player Card) -->
    <DailyAudioNews />

    <!-- 5. Latest News Grid Section -->
    <section>
      <div class="mb-6 flex flex-col justify-between gap-4 border-b border-slate-200/80 pb-4 sm:flex-row sm:items-end dark:border-slate-800">
        <div>
          <span class="block text-[11px] font-bold tracking-wider text-[#D52B1E] uppercase dark:text-red-400">
            MARKET DOSSIERS
          </span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
            Sectoral Intelligence & Analysis
          </h2>
        </div>
        
        <a 
          href="/news"
          class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 shadow-2xs transition hover:border-[#D52B1E]/40 hover:text-[#D52B1E] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-red-800 dark:hover:text-red-400"
        >
          <span>View All 50 News Articles</span>
          <span>→</span>
        </a>
      </div>

      <!-- Responsive News Cards Grid -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gridNews.map((article: any) => (
          <NewsCard article={article} />
        ))}
      </div>
    </section>

    <!-- 6. Premium Business Spotlight Section -->
    <section>
      <div class="mb-6 flex flex-col justify-between gap-4 border-b border-slate-200/80 pb-4 sm:flex-row sm:items-end dark:border-slate-800">
        <div>
          <span class="block text-[11px] font-bold tracking-wider text-[#D52B1E] uppercase dark:text-red-400">
            VERIFIED DIRECTORY
          </span>
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
            Swiss Business Spotlight
          </h2>
        </div>
        
        <a 
          href="/unternehmen" 
          class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 shadow-2xs transition hover:border-[#D52B1E]/40 hover:text-[#D52B1E] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-red-800 dark:hover:text-red-400"
        >
          <span>Explore All 17 Companies</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredCompanies.map((comp: any) => (
          <CompanyCard company={comp} />
        ))}
      </div>
    </section>

    <!-- 7. Cantonal & Commercial Register Intelligence -->
    <HomepageGraphics />

  </div>
</Base>
