---
// emdash-site/src/pages/index.astro
import Base from "../layouts/Base.astro";
import BreakingBanner from "../components/BreakingBanner.astro";
import DailyAudioNews from "../components/DailyAudioNews.astro";
import Hero from "../components/Hero.astro";
import NewsCard from "../components/NewsCard.astro";
import CompanyCard from "../components/CompanyCard.astro";
import HomepageGraphics from "../components/HomepageGraphics.astro";
import { getNews, getCompanies } from "../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";

// Fetch news and featured companies directly from native backend
const allNews = getNews(12);
const featuredCompanies = getCompanies(true, 4);
---

<Base 
  title="privatesector.ch — Swiss Private Sector Business Platform"
  description="Switzerland's authoritative Private Sector Intelligence Platform. Daily morning briefings, verified Swiss B2B directory, and corporate market dossiers."
  locale={currentLocale}
>
  <!-- 1. Breaking News Red Ticker Banner -->
  <BreakingBanner />

  <!-- 2. Apple / Google Modern Hero -->
  <Hero />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-12 md:space-y-16">
    
    <!-- 3. Daily Audio Briefing (Podcast Player) -->
    <DailyAudioNews />

    <!-- 4. Latest News & Market Archive Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 mb-6 border-b border-slate-200/80 dark:border-slate-800">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-600 dark:text-red-400 block mb-1">
            INTELLIGENCE DESK
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            Latest News & Market Bulletins
          </h2>
        </div>
        
        <a 
          href="/news"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-red-500/50 hover:text-red-600 dark:hover:text-red-400 shadow-2xs transition-all self-start sm:self-auto"
        >
          <span>View All 50 News Archives</span>
          <span>→</span>
        </a>
      </div>

      <!-- Responsive News Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {allNews.map((article: any) => (
          <NewsCard article={article} />
        ))}
      </div>
    </section>

    <!-- 5. Premium Business Spotlight Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 mb-6 border-b border-slate-200/80 dark:border-slate-800">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-600 dark:text-red-400 block mb-1">
            VERIFIED ENTERPRISE DIRECTORY
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            Swiss Business Spotlight
          </h2>
        </div>
        
        <a 
          href="/unternehmen" 
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-red-500/50 hover:text-red-600 dark:hover:text-red-400 shadow-2xs transition-all self-start sm:self-auto"
        >
          <span>Explore All 17 Companies</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredCompanies.map((comp: any) => (
          <CompanyCard company={comp} />
        ))}
      </div>
    </section>

    <!-- 6. Cantonal & Commercial Register Intelligence -->
    <HomepageGraphics />

  </div>
</Base>
