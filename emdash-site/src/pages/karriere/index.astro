---
// emdash-site/src/pages/karriere/index.astro
import Base from "../../layouts/Base.astro";
import { getJobs } from "../../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";
const jobs = getJobs(50);
---

<Base
  title="Swiss Executive & Commercial Career Board — PrivateSector.ch"
  description="Career opportunities, executive mandates, and student internships across Switzerland's leading private sector employers."
  locale={currentLocale}
>
  <!-- Header Bar -->
  <section class="bg-white dark:bg-[#0E1524] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 uppercase tracking-wider">
        TALENT & EXECUTIVE MANDATES
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Swiss Executive & Commercial Careers
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Direct career opportunities across Swiss financial hubs, pharmaceutical centers, and advanced manufacturing clusters.
      </p>
    </div>
  </section>

  <!-- Job Listings Stack -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="space-y-4">
      {jobs.map((job: any) => (
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-xs hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2.5 max-w-3xl">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 uppercase tracking-wider">
                {job.job_type || 'Full-time'}
              </span>
              <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                📍 {job.location || 'Switzerland'}
              </span>
            </div>
            
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-snug">
              {job.title}
            </h2>

            <div class="text-xs sm:text-sm font-semibold text-red-600 dark:text-red-400">
              {job.company_name}
            </div>

            {job.description && (
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                {job.description}
              </p>
            )}
          </div>

          <div class="shrink-0">
            <a 
              href={job.apply_url || "mailto:careers@privatesector.ch"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-[#D52B1E] hover:bg-red-700 text-white shadow-xs transition-colors"
            >
              <span>Apply Mandate</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>
</Base>
