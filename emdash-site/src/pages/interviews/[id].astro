---
// emdash-site/src/pages/interviews/[id].astro
import Base from "../../layouts/Base.astro";
import { getInterviewById } from "../../lib/legacy-db";

const idOrSlug = Astro.params.id;
if (!idOrSlug) {
  return Astro.redirect("/interviews");
}

const interview = await getInterviewById(idOrSlug) as any;

if (!interview) {
  return Astro.redirect("/404");
}

let parsedQA: any[] = [];
if (interview.qa_content) {
  try {
    parsedQA = typeof interview.qa_content === 'string' ? JSON.parse(interview.qa_content) : interview.qa_content;
  } catch (e) {
    parsedQA = [];
  }
}
---

<Base
  title={`${interview.title} — Executive Interview | PrivateSector.ch`}
  description={interview.subtitle || `In-depth executive discussion with ${interview.interviewee_name}, ${interview.interviewee_title}.`}
>
  <!-- Interview Header -->
  <header class="bg-white dark:bg-[#0B0F19] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <a href="/interviews" class="hover:text-slate-900 dark:hover:text-white transition-colors">Interviews</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="text-red-600 dark:text-red-400 font-semibold truncate max-w-[200px]">{interview.interviewee_name}</span>
      </nav>

      <div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-900/40 uppercase tracking-wider">
          EXECUTIVE INTERVIEW
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.18] hyphen-guard">
        {interview.title}
      </h1>

      {interview.subtitle && (
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          {interview.subtitle}
        </p>
      )}

      <!-- Interviewee Profile Card -->
      <div class="p-6 rounded-3xl bg-slate-50/80 dark:bg-slate-850/60 border border-slate-200/80 dark:border-slate-800/80 flex items-center gap-4 sm:gap-5 shadow-2xs">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center font-bold text-lg sm:text-xl shadow-xs shrink-0 border border-slate-700">
          {interview.interviewee_name ? interview.interviewee_name.charAt(0) : 'I'}
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="font-bold text-base sm:text-xl text-slate-900 dark:text-white">
            {interview.interviewee_name}
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            {interview.interviewee_title} at <strong class="text-slate-900 dark:text-white font-semibold">{interview.company_name}</strong>
          </p>
        </div>
      </div>

    </div>
  </header>

  <!-- Q&A Conversation Stream -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Audio Player if present -->
    {interview.audio_url && (
      <div class="bg-slate-900 dark:bg-[#0E1524] text-white rounded-3xl p-6 mb-10 shadow-md border border-slate-800 flex items-center gap-4 sm:gap-5">
        <div class="w-12 h-12 rounded-2xl bg-[#D52B1E] text-white flex items-center justify-center shrink-0 shadow-sm">
          <svg class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
        <div class="flex-1 min-w-0 space-y-1.5">
          <span class="text-[11px] font-bold text-red-400 uppercase tracking-wider block">
            OFFICIAL AUDIO RECORDING
          </span>
          <audio controls src={interview.audio_url} class="w-full h-8 outline-none"></audio>
        </div>
      </div>
    )}

    <!-- Q&A Content Block -->
    {parsedQA.length > 0 ? (
      <div class="space-y-6 sm:space-y-8">
        {parsedQA.map((item: any, idx: number) => (
          <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 shadow-xs space-y-4">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-start gap-3 leading-snug">
              <span class="px-2.5 py-0.5 rounded-full bg-red-50 dark:bg-red-950/80 text-xs font-extrabold text-red-700 dark:text-red-400 shrink-0 border border-red-200/60 dark:border-red-900/40">
                Q{idx + 1}
              </span>
              <span>{item.q || item.question}</span>
            </h3>
            <div class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/80 pt-4">
              {item.a || item.answer}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="editorial-prose dark:prose-invert">
        {interview.content && <p>{interview.content}</p>}
      </div>
    )}

    <!-- Back to Interviews -->
    <div class="mt-12 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 text-center">
      <a href="/interviews" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors">
        <span>← All Executive Interviews</span>
      </a>
    </div>

  </main>
</Base>
