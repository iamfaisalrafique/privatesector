---
// emdash-site/src/pages/interviews/index.astro
import Base from "../../layouts/Base.astro";
import { getInterviews } from "../../lib/legacy-db";

const interviews = getInterviews(50);
---

<Base 
  title="CEO & Executive Interviews — PrivateSector.ch"
  description="Exclusive in-depth conversations with corporate leaders, founders, and policy decision-makers across the Swiss private sector."
>
  <div style="background-color: #FFFFFF; border-bottom: 1px solid #E5E7EB; padding: 48px 24px;">
    <div style="max-width: 1600px; margin: 0 auto;">
      <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #D52B1E; display: block; margin-bottom: 8px;">
        EXECUTIVE ACCESS
      </span>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 36px; font-weight: 700; color: #000000; margin: 0 0 16px 0;">
        CEO & Executive Interviews
      </h1>
      <p style="font-size: 16px; color: #4B5563; max-width: 720px; margin: 0;">
        Direct perspectives from leaders guiding Switzerland's industrial, financial, and pharmaceutical champions.
      </p>
    </div>
  </div>

  <main style="max-width: 1600px; margin: 0 auto; padding: 48px 24px 96px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 28px;">
      {interviews.map((item: any) => (
        <a 
          href={`/interviews/${item.slug || item.id}`}
          style="text-decoration: none; background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.15s ease, box-shadow 0.15s ease;"
          class="interview-card"
        >
          <div style="padding: 24px;">
            <div style="display: flex; gap: 14px; align-items: center; margin-bottom: 16px;">
              <div style="width: 48px; height: 48px; border-radius: 50%; background-color: #0A0A0A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">
                {item.interviewee_name ? item.interviewee_name.charAt(0) : 'I'}
              </div>
              <div>
                <strong style="font-size: 15px; color: #111827; display: block;">{item.interviewee_name}</strong>
                <span style="font-size: 12px; color: #6B7280;">{item.interviewee_title} • {item.company_name}</span>
              </div>
            </div>

            <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 700; color: #000000; margin: 0 0 10px 0; line-height: 1.35;">
              {item.title}
            </h2>

            {item.subtitle && (
              <p style="font-size: 13px; color: #4B5563; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {item.subtitle}
              </p>
            )}
          </div>

          <div style="border-top: 1px solid #F3F4F6; padding: 14px 24px; background-color: #FAFAFA; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
            <span style="color: #6B7280;">
              {item.audio_url ? '🎙️ Audio & Q&A' : '📝 Full Q&A Transcript'}
            </span>
            <span style="color: #D52B1E; font-weight: 600;">
              Read Interview →
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .interview-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px -4px rgba(0,0,0,0.08);
    border-color: #D52B1E !important;
  }
</style>
