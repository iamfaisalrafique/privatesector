---
// emdash-site/src/pages/interviews/index.astro
import Base from "../../layouts/Base.astro";
import { getInterviews } from "../../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";
const interviews = getInterviews(50);
---

<Base 
  title="CEO & Executive Interviews — PrivateSector.ch"
  description="Exclusive in-depth conversations with corporate leaders, founders, and policy decision-makers across the Swiss private sector."
  locale={currentLocale}
>
  <!-- Page Header -->
  <section class="bg-white dark:bg-[#0E1524] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 uppercase tracking-wider">
        EXECUTIVE ACCESS & DIALOGUE
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        CEO & Executive Interviews
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Direct perspectives from leaders guiding Switzerland's industrial, financial, and pharmaceutical champions.
      </p>
    </div>
  </section>

  <!-- Grid of Interviews -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {interviews.map((item: any) => (
        <a 
          href={`/interviews/${item.slug || item.id}`}
          class="group flex flex-col justify-between bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-xs hover:shadow-lg hover:-translate-y-1 transition-all duration-200"
        >
          <div class="space-y-4">
            <!-- Executive Profile Header -->
            <div class="flex items-center gap-3.5">
              <div class="w-12 h-12 rounded-full bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0 border border-slate-700">
                {item.interviewee_name ? item.interviewee_name.charAt(0) : 'I'}
              </div>
              <div class="min-w-0 flex-1">
                <strong class="text-sm font-bold text-slate-900 dark:text-white block truncate">
                  {item.interviewee_name}
                </strong>
                <span class="text-xs text-slate-500 dark:text-slate-400 truncate block">
                  {item.interviewee_title} • {item.company_name}
                </span>
              </div>
            </div>

            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors leading-snug line-clamp-2">
              {item.title}
            </h2>

            {item.subtitle && (
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
                {item.subtitle}
              </p>
            )}
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">
              {item.audio_url ? '🎙️ Audio & Q&A' : '📝 Transcript Q&A'}
            </span>
            <span class="font-semibold text-red-600 dark:text-red-400 group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
              <span>Read Interview</span>
              <span>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>
