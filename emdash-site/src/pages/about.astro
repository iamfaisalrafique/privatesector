---
// emdash-site/src/pages/about.astro
import Base from "../layouts/Base.astro";
---

<Base 
  title="About Us — Mission & Editorial Standards | PrivateSector.ch"
  description="Authoritative source of truth for Swiss B2B relationships, trade indicators, and corporate market intelligence."
>
  <div style="background-color: #FFFFFF; border-bottom: 1px solid #E5E7EB; padding: 48px 24px;">
    <div style="max-width: 860px; margin: 0 auto;">
      <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #D52B1E; display: block; margin-bottom: 8px;">
        MISSION & GOVERNANCE
      </span>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 38px; font-weight: 700; color: #000000; margin: 0 0 16px 0; line-height: 1.2;">
        Bridging Swiss Precision and Global Enterprise Innovation
      </h1>
      <p style="font-size: 17px; line-height: 1.7; color: #4B5563; margin: 0;">
        Established in Zurich, <strong>privatesector.ch</strong> serves as Switzerland's independent intelligence platform for verified corporate data, market analyses, commercial registry movements, and transatlantic trade corridors.
      </p>
    </div>
  </div>

  <main style="max-width: 860px; margin: 0 auto; padding: 48px 24px 96px; font-family: Inter, sans-serif;">
    <div style="font-size: 16px; line-height: 1.8; color: #374151; display: flex; flex-direction: column; gap: 20px;">
      <p>
        Our platform provides verified corporate data, market analyses, and trade reports, ensuring transparency and facilitating cross-border collaborations. With the recent inclusion of our Southern California Gateway, we are directly enabling a pipeline of technology, R&D capital, and structural investments between the two regions.
      </p>
      <p>
        Every report, company profile, and dataset published on <strong>privatesector.ch</strong> is cross-referenced with the Swiss Official Gazette of Commerce (SOGC / SHAB) and audited for 100% data fidelity.
      </p>
    </div>

    <!-- Core Pillars Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-top: 40px; margin-bottom: 40px;">
      <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px;">
        <span style="font-size: 24px; display: block; margin-bottom: 12px;">🛡️</span>
        <strong style="display: block; font-size: 16px; color: #000000; margin-bottom: 8px;">Verified Swiss Data</strong>
        <p style="font-size: 13px; color: #4B5563; line-height: 1.6; margin: 0;">
          Zefix and SOGC-integrated registry checks and audit-trails for all premium business records.
        </p>
      </div>

      <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px;">
        <span style="font-size: 24px; display: block; margin-bottom: 12px;">🎯</span>
        <strong style="display: block; font-size: 16px; color: #000000; margin-bottom: 8px;">Focus Corridors</strong>
        <p style="font-size: 13px; color: #4B5563; line-height: 1.6; margin: 0;">
          Specialized intelligence supporting high-tech, biotechnology, aerospace, and finance trade lanes.
        </p>
      </div>

      <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px;">
        <span style="font-size: 24px; display: block; margin-bottom: 12px;">👥</span>
        <strong style="display: block; font-size: 16px; color: #000000; margin-bottom: 8px;">Bilateral Network</strong>
        <p style="font-size: 13px; color: #4B5563; line-height: 1.6; margin: 0;">
          Dual advisory boards active across Swiss economic hubs and transatlantic partners.
        </p>
      </div>
    </div>

    <!-- Call to Action Banner -->
    <div style="background-color: #D52B1E; color: #FFFFFF; border-radius: 8px; padding: 36px 32px; text-align: center;">
      <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 24px; font-weight: 700; margin: 0 0 10px 0;">
        List or Verify Your Swiss Enterprise
      </h3>
      <p style="font-size: 14px; opacity: 0.9; margin: 0 0 20px 0; max-width: 500px; margin-left: auto; margin-right: auto;">
        Ensure your company dossier is accurately reflected in Switzerland's definitive private sector register.
      </p>
      <a 
        href="/contact" 
        style="display: inline-block; background-color: #FFFFFF; color: #D52B1E; font-weight: 700; font-size: 13px; padding: 12px 28px; border-radius: 6px; text-decoration: none;"
      >
        Contact the Editorial Desk
      </a>
    </div>
  </main>
</Base>
