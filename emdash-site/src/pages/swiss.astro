---
// emdash-site/src/pages/swiss.astro
import Base from "../layouts/Base.astro";
import NewsCard from "../components/NewsCard.astro";
import CompanyCard from "../components/CompanyCard.astro";
import { getNews, getCompanies } from "../lib/legacy-db";

const allNews = getNews();
const swissNews = allNews.filter((a: any) => 
  a.title?.toLowerCase().includes('swiss') || 
  a.content?.toLowerCase().includes('switzerland') || 
  a.category?.toLowerCase() === 'economy' ||
  a.category?.toLowerCase() === 'swiss'
).slice(0, 9);

const allCompanies = getCompanies();
const swissCompanies = allCompanies.filter((c: any) => 
  !c.country || c.country.toLowerCase() === 'switzerland' || c.country.toLowerCase() === 'ch'
).slice(0, 8);
---

<Base title="Swiss Economy & Companies | PrivateSector.ch" description="Dedicated intelligence on the Swiss economy, multinational champions, and cantonal enterprises.">
  <div class="min-h-[calc(100vh-120px)] py-10 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav class="mb-8 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="transition hover:text-slate-900 dark:hover:text-white">Home</a>
        <span>/</span>
        <span class="font-semibold text-slate-900 dark:text-white">Swiss Economy</span>
      </nav>

      <!-- Header Block -->
      <div class="mb-12">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-red-200/60 bg-red-50/80 px-3.5 py-1 text-[11px] font-bold tracking-widest text-[#D52B1E] uppercase dark:border-red-900/40 dark:bg-red-950/40 dark:text-red-400">
          <svg width="16" height="12" viewBox="0 0 32 24" class="rounded-xs shrink-0">
            <rect width="32" height="24" fill="#D52B1E" />
            <rect x="13" y="4" width="6" height="16" fill="#FFFFFF" />
            <rect x="7" y="9" width="18" height="6" fill="#FFFFFF" />
          </svg>
          Swiss Enterprise Radar
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
          Switzerland Business & Economy
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
          Tracking the confederation's economic pillars, precision machinery exporters, banking titans, and pharma powerhouses across 26 cantons.
        </p>
      </div>

      <!-- Section: Key Swiss Companies -->
      <section class="mb-16">
        <div class="mb-8 flex items-center justify-between border-b border-slate-200/80 pb-4 dark:border-slate-800">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl dark:text-white">
            Featured Swiss Enterprises
          </h2>
          <a href="/unternehmen" class="text-xs font-bold text-[#D52B1E] transition hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
            View All Companies →
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {swissCompanies.map((c: any) => (
            <CompanyCard company={c} />
          ))}
        </div>
      </section>

      <!-- Section: Swiss Intelligence Stories -->
      <section>
        <div class="mb-8 flex items-center justify-between border-b border-slate-200/80 pb-4 dark:border-slate-800">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl dark:text-white">
            Swiss Business Intelligence
          </h2>
          <a href="/news" class="text-xs font-bold text-[#D52B1E] transition hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
            View All News →
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {swissNews.map((art: any) => (
            <NewsCard article={art} />
          ))}
        </div>
      </section>

    </div>
  </div>
</Base>
