---
import Base from "../../layouts/Base.astro";
import { getSiteSettings } from "emdash";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

export const prerender = false;

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
---

<Base
  title={`Market Commentary & Blogs | ${siteTitle}`}
  pageTitle="Market Commentary & Blogs"
  description="Expert perspectives and market intelligence on Swiss enterprise and private sector developments."
>
  <main class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-12 border-b border-neutral-200 dark:border-neutral-800 pb-8">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Market Commentary</h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">
        In-depth commentary, macroeconomic analysis, and opinion from Swiss industry observers.
      </p>
    </header>

    <div class="py-12 text-center text-neutral-500">
      <p class="text-base">New editorial commentary and guest columns are coming soon.</p>
    </div>
  </main>
</Base>
