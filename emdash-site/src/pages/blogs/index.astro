---
// emdash-site/src/pages/blogs/index.astro
import Base from "../../layouts/Base.astro";
import { getBlogs } from "../../lib/legacy-db";
import NewsCard from "../../components/NewsCard.astro";

export const prerender = false;

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";
const blogs = getBlogs(50);
---

<Base
  title="Market Commentary & Perspectives — PrivateSector.ch"
  description="In-depth market commentary, macroeconomic perspectives, and editorial opinions on Swiss private enterprise."
  locale={currentLocale}
>
  <!-- Page Header -->
  <section class="bg-white dark:bg-[#0E1524] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 uppercase tracking-wider">
        OPINION & ANALYSIS
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Market Perspectives & Commentary
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Specialist insights, regulatory breakdowns, and strategic commentary from Swiss industry analysts.
      </p>
    </div>
  </section>

  <!-- Blog Cards Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {blogs.length === 0 ? (
      <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-8 shadow-xs">
        <p class="text-sm text-slate-500">No blog posts published yet.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {blogs.map((b: any) => (
          <NewsCard article={b} />
        ))}
      </div>
    )}
  </main>
</Base>
