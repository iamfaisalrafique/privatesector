---
// emdash-site/src/pages/blogs/[...slug].astro
import Base from "../../layouts/Base.astro";
import { DatabaseSync } from "node:sqlite";
import path from "node:path";
import { marked } from "marked";

export const prerender = false;

const rawSlug = Astro.params.slug;
if (!rawSlug) {
  return Astro.redirect("/blogs", 301);
}

const dbPath = path.resolve(process.cwd(), '../server/database.sqlite');
const db = new DatabaseSync(dbPath);

const blog = db.prepare("SELECT * FROM blogs WHERE slug = ? OR id = ? LIMIT 1").get(rawSlug, rawSlug) as any;

if (!blog) {
  return Astro.redirect("/blogs", 301);
}

const renderedHtml = blog.content_body ? (marked.parse(blog.content_body) as string) : "";
---

<Base
  title={`${blog.title} — Market Perspective | PrivateSector.ch`}
  description={blog.subtitle || blog.title}
  image={blog.image_url || "/logo.png"}
>
  <header class="bg-white dark:bg-[#0B0F19] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <a href="/blogs" class="hover:text-slate-900 dark:hover:text-white transition-colors">Blogs</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="text-red-600 dark:text-red-400 font-semibold truncate max-w-[200px]">{blog.category || 'Perspective'}</span>
      </nav>

      <div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-900/40 uppercase tracking-wider">
          {blog.category || 'MARKET PERSPECTIVE'}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.18] hyphen-guard">
        {blog.title}
      </h1>

      {blog.subtitle && (
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          {blog.subtitle}
        </p>
      )}

      <div class="pt-6 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-slate-900 dark:bg-slate-700 text-white flex items-center justify-center font-bold text-[10px]">
            {blog.author_name ? blog.author_name.charAt(0) : 'P'}
          </div>
          <span>By <strong class="text-slate-900 dark:text-white font-semibold">{blog.author_name || 'PrivateSector Analyst'}</strong></span>
        </div>
        {blog.date_published && <span>• 📅 {blog.date_published}</span>}
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {blog.image_url && (
      <div class="mb-10 rounded-3xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-md bg-slate-100 dark:bg-slate-800 aspect-[16/10] sm:aspect-[2/1]">
        <img src={blog.image_url} alt="" class="w-full h-full object-cover" onerror="this.style.display='none'" />
      </div>
    )}

    {blog.pull_quote && (
      <blockquote class="my-8 p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-850/60 border-l-4 border-red-600 text-lg sm:text-xl font-medium italic text-slate-800 dark:text-slate-200 shadow-2xs leading-relaxed">
        "{blog.pull_quote}"
      </blockquote>
    )}

    <article class="editorial-prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg">
      <div set:html={renderedHtml} />
    </article>

    <div class="mt-12 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
      <a href="/blogs" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors">
        ← Back to All Blogs
      </a>
    </div>
  </main>
</Base>
