---
// emdash-site/src/pages/statistiken/index.astro
import Base from "../../layouts/Base.astro";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";

const gdpTrend = [
  { year: 2018, value: 710 }, { year: 2019, value: 725 }, { year: 2020, value: 702 },
  { year: 2021, value: 735 }, { year: 2022, value: 750 }, { year: 2023, value: 765 },
  { year: 2024, value: 780 }, { year: 2025, value: 792 }, { year: 2026, value: 805 }
];

const sectors = [
  { name: 'Manufacturing & Advanced Tech', share: 18, color: '#D52B1E' },
  { name: 'Retail & Wholesale Trade', share: 12, color: '#2563EB' },
  { name: 'Financial & Wealth Services', share: 10, color: '#0F172A' },
  { name: 'Pharmaceuticals & Life Sciences', share: 9, color: '#059669' },
  { name: 'Tourism & Hospitality', share: 6, color: '#D97706' },
  { name: 'Luxury Goods & Chronometry', share: 4, color: '#7C3AED' },
  { name: 'Other Diversified Industries', share: 41, color: '#64748B' }
];

const cantons = [
  { code: 'ZH', name: 'Zürich', gdp: '21.5%', firms: "124'820", weight: 95 },
  { code: 'BE', name: 'Bern', gdp: '12.8%', firms: "78'410", weight: 80 },
  { code: 'GE', name: 'Genève', gdp: '9.2%', firms: "46'950", weight: 90 },
  { code: 'VD', name: 'Vaud', gdp: '8.7%', firms: "42'110", weight: 85 },
  { code: 'BS', name: 'Basel-Stadt', gdp: '7.1%', firms: "28'730", weight: 88 },
  { code: 'ZG', name: 'Zug', gdp: '4.8%', firms: "24'550", weight: 92 },
  { code: 'SG', name: 'St. Gallen', gdp: '4.2%', firms: "22'180", weight: 60 },
  { code: 'AG', name: 'Aargau', gdp: '3.9%', firms: "19'400", weight: 70 },
  { code: 'LU', name: 'Luzern', gdp: '3.4%', firms: "17'800", weight: 55 },
  { code: 'TI', name: 'Ticino', gdp: '3.1%', firms: "16'200", weight: 50 },
];
---

<Base 
  title="Swiss Economic Statistics & Heatmaps — PrivateSector.ch"
  description="Macroeconomic indicators, Gross Domestic Product trends, Cantonal heatmaps, and enterprise density statistics."
  locale={currentLocale}
>
  <!-- Page Header -->
  <section class="bg-white dark:bg-[#0E1524] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 uppercase tracking-wider">
        MACROECONOMIC RADAR & ANALYTICS
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Swiss Economic Matrix & Cantonal Analytics
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Interactive intelligence on national macroeconomic output, workforce productivity, industrial shares, and cantonal capital allocations.
      </p>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <!-- Top KPI Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-xs border-l-4 border-l-red-600">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Swiss National GDP</span>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tabular-nums my-1">
          CHF 805 Bn
        </div>
        <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">+1.6% Annual Growth</span>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-xs border-l-4 border-l-slate-900 dark:border-l-slate-400">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Workforce Employed</span>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tabular-nums my-1">
          5.40 Million
        </div>
        <span class="text-xs text-slate-500 font-medium">Unemployment Rate: 2.3%</span>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-xs border-l-4 border-l-red-600">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Active Registered Firms</span>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tabular-nums my-1">
          614'230
        </div>
        <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">SOGC Registry Synchronized</span>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-xs border-l-4 border-l-emerald-600">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">Trade Surplus</span>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tabular-nums my-1">
          CHF +42.8 Bn
        </div>
        <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">U.S. & EU Top Export Markets</span>
      </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- GDP Trajectory -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            GDP Growth Trajectory (2018–2026)
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">In Billion CHF (Current Prices)</p>
        </div>

        <div class="flex items-end justify-between h-48 pt-6 border-b border-slate-100 dark:border-slate-800 gap-2">
          {gdpTrend.map((g) => {
            const heightPct = Math.max(15, Math.round(((g.value - 680) / 130) * 100));
            return (
              <div class="flex flex-col items-center justify-end h-full flex-1 group">
                <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300 tabular-nums mb-1">
                  {g.value}
                </span>
                <div class="w-full flex justify-center items-end h-32">
                  <div 
                    class="w-full max-w-[28px] bg-[#D52B1E] group-hover:bg-red-700 rounded-t-md transition-all duration-300" 
                    style={`height: ${heightPct}%;`}
                  ></div>
                </div>
                <span class="text-[10px] text-slate-500 tabular-nums mt-1.5">
                  {g.year}
                </span>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Sector Composition -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            Industrial Sector Composition
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Contribution to Total Gross Value Added (%)</p>
        </div>

        <div class="space-y-3 pt-2">
          {sectors.map((s) => (
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-semibold text-slate-800 dark:text-slate-200">{s.name}</span>
                <span class="font-bold text-slate-600 dark:text-slate-400 tabular-nums">{s.share}%</span>
              </div>
              <div class="h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full rounded-full" style={`width: ${s.share * 2.2}%; background-color: ${s.color};`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Cantonal Matrix Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 sm:p-7 shadow-xs space-y-4">
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">
          Cantonal Economic Matrix (Top 10)
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Breakdown of commercial firms, contribution to national GDP, and economic concentration index.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
              <th class="py-3 px-4">Canton</th>
              <th class="py-3 px-4">Active Firms</th>
              <th class="py-3 px-4">Share of Swiss GDP</th>
              <th class="py-3 px-4">Economic Weight</th>
              <th class="py-3 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {cantons.map((c) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">
                  {c.name} ({c.code})
                </td>
                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-300 tabular-nums">
                  {c.firms}
                </td>
                <td class="py-3.5 px-4 font-bold text-red-600 dark:text-red-400 tabular-nums">
                  {c.gdp}
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex px-2 py-0.5 rounded-md font-bold text-xs bg-red-50 dark:bg-red-950/60 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900/60">
                    {c.weight}/100
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a href={`/unternehmen?canton=${c.code}`} class="text-xs font-semibold text-red-600 dark:text-red-400 hover:underline">
                    Browse Firms →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </main>
</Base>
