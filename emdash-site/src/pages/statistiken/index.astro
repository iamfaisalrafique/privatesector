---
// emdash-site/src/pages/statistiken/index.astro
import Base from "../../layouts/Base.astro";

const gdpTrend = [
  { year: 2018, value: 710 }, { year: 2019, value: 725 }, { year: 2020, value: 702 },
  { year: 2021, value: 735 }, { year: 2022, value: 750 }, { year: 2023, value: 765 },
  { year: 2024, value: 780 }, { year: 2025, value: 792 }, { year: 2026, value: 805 }
];

const sectors = [
  { name: 'Manufacturing & Tech', share: 18, color: '#D52B1E' },
  { name: 'Retail & Wholesale', share: 12, color: '#003453' },
  { name: 'Financial Services', share: 10, color: '#8B0000' },
  { name: 'Pharmaceuticals & Biotech', share: 9, color: '#4A6741' },
  { name: 'Tourism & Hospitality', share: 6, color: '#D4AF37' },
  { name: 'Luxury Goods & Watchmaking', share: 4, color: '#5A5A5A' },
  { name: 'Other Diversified Sectors', share: 41, color: '#9CA3AF' }
];

const cantons = [
  { code: 'ZH', name: 'Zürich', gdp: '21.5%', firms: "124'820", weight: 95 },
  { code: 'BE', name: 'Bern', gdp: '12.8%', firms: "78'410", weight: 80 },
  { code: 'GE', name: 'Genève', gdp: '9.2%', firms: "46'950", weight: 90 },
  { code: 'VD', name: 'Vaud', gdp: '8.7%', firms: "42'110", weight: 85 },
  { code: 'BS', name: 'Basel-Stadt', gdp: '7.1%', firms: "28'730", weight: 88 },
  { code: 'ZG', name: 'Zug', gdp: '4.8%', firms: "24'550", weight: 92 },
  { code: 'SG', name: 'St. Gallen', gdp: '4.2%', firms: "22'180", weight: 60 },
  { code: 'AG', name: 'Aargau', gdp: '3.9%', firms: "19'400", weight: 70 },
  { code: 'LU', name: 'Luzern', gdp: '3.4%', firms: "17'800", weight: 55 },
  { code: 'TI', name: 'Ticino', gdp: '3.1%', firms: "16'200", weight: 50 },
];
---

<Base 
  title="Swiss Economic Statistics & Heatmaps — PrivateSector.ch"
  description="Macroeconomic indicators, Gross Domestic Product trends, Cantonal heatmaps, and enterprise density statistics."
>
  <div style="background-color: #FFFFFF; border-bottom: 1px solid #E5E7EB; padding: 48px 24px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #D52B1E; display: block; margin-bottom: 8px;">
        DATA & ANALYTICS
      </span>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 36px; font-weight: 700; color: #000000; margin: 0 0 16px 0;">
        Swiss Economic Matrix & Cantonal Statistics
      </h1>
      <p style="font-size: 16px; color: #4B5563; max-width: 720px; margin: 0;">
        Interactive intelligence on national macroeconomic output, workforce productivity, industrial shares, and cantonal capital allocations.
      </p>
    </div>
  </div>

  <main style="max-width: 1400px; margin: 0 auto; padding: 48px 24px 96px;">
    
    <!-- Top Highlights -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 48px;">
      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; border-left: 4px solid #D52B1E;">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6B7280;">Swiss National GDP</span>
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 28px; font-weight: 700; color: #000000; margin: 8px 0;">
          CHF 805 Bn
        </div>
        <span style="font-size: 12px; color: #10B981; font-weight: 600;">+1.6% Annual Growth</span>
      </div>

      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; border-left: 4px solid #0A0A0A;">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6B7280;">Workforce Employed</span>
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 28px; font-weight: 700; color: #000000; margin: 8px 0;">
          5.40 Million
        </div>
        <span style="font-size: 12px; color: #6B7280; font-weight: 500;">Unemployment Rate: 2.3%</span>
      </div>

      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; border-left: 4px solid #D52B1E;">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6B7280;">Active Registered Firms</span>
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 28px; font-weight: 700; color: #000000; margin: 8px 0;">
          614'230
        </div>
        <span style="font-size: 12px; color: #10B981; font-weight: 600;">SOGC Register Sync Active</span>
      </div>

      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; border-left: 4px solid #059669;">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6B7280;">Trade Surplus</span>
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 28px; font-weight: 700; color: #000000; margin: 8px 0;">
          CHF +42.8 Bn
        </div>
        <span style="font-size: 12px; color: #10B981; font-weight: 600;">U.S. & EU Top Export Markets</span>
      </div>
    </div>

    <!-- Charts Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 32px; margin-bottom: 48px;" class="stats-charts-grid">
      
      <!-- GDP Trajectory -->
      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 28px;">
        <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; margin: 0 0 6px 0;">
          GDP Growth Trajectory (2018–2026)
        </h3>
        <p style="font-size: 12.5px; color: #6B7280; margin: 0 0 24px 0;">In Billion CHF (Current Prices)</p>

        <div style="display: flex; align-items: flex-end; justify-content: space-between; height: 180px; padding-top: 20px; border-bottom: 1px solid #E5E7EB;">
          {gdpTrend.map((g) => {
            const heightPct = Math.round(((g.value - 680) / 130) * 100);
            return (
              <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1;">
                <span style="font-size: 10px; font-weight: 700; color: #111827;">{g.value}</span>
                <div style={`width: 24px; height: ${heightPct}%; background-color: #D52B1E; border-radius: 3px 3px 0 0; transition: height 0.3s ease;`}></div>
                <span style="font-size: 11px; color: #6B7280; margin-top: 4px;">{g.year}</span>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Sector Breakdown -->
      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 28px;">
        <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; margin: 0 0 6px 0;">
          Industrial Sector Composition
        </h3>
        <p style="font-size: 12.5px; color: #6B7280; margin: 0 0 24px 0;">Contribution to Total Gross Value Added (%)</p>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          {sectors.map((s) => (
            <div>
              <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                <span style="font-weight: 600; color: #111827;">{s.name}</span>
                <span style="font-weight: 700; color: #4B5563;">{s.share}%</span>
              </div>
              <div style="height: 6px; background-color: #F3F4F6; border-radius: 3px; overflow: hidden;">
                <div style={`width: ${s.share * 2}%; height: 100%; background-color: ${s.color}; border-radius: 3px;`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Cantonal League Matrix Table -->
    <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 28px;">
      <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; margin: 0 0 6px 0;">
        Cantonal Economic Matrix (Top 10)
      </h3>
      <p style="font-size: 12.5px; color: #6B7280; margin: 0 0 20px 0;">
        Breakdown of commercial firms, contribution to national GDP, and economic concentration.
      </p>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid #E5E7EB; color: #6B7280; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
              <th style="padding: 12px 16px;">Canton</th>
              <th style="padding: 12px 16px;">Active Firms</th>
              <th style="padding: 12px 16px;">Share of Swiss GDP</th>
              <th style="padding: 12px 16px;">Economic Weight Index</th>
              <th style="padding: 12px 16px; text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            {cantons.map((c) => (
              <tr style="border-bottom: 1px solid #F3F4F6;">
                <td style="padding: 14px 16px; font-weight: 700; color: #000000;">
                  {c.name} ({c.code})
                </td>
                <td style="padding: 14px 16px; color: #374151;">
                  {c.firms}
                </td>
                <td style="padding: 14px 16px; font-weight: 600; color: #D52B1E;">
                  {c.gdp}
                </td>
                <td style="padding: 14px 16px;">
                  <span style="background: #FFF5F5; color: #D52B1E; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 11px;">
                    {c.weight}/100
                  </span>
                </td>
                <td style="padding: 14px 16px; text-align: right;">
                  <a href={`/unternehmen?canton=${c.code}`} style="color: #D52B1E; text-decoration: none; font-weight: 600; font-size: 12px;">
                    Browse Firms →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </main>
</Base>

<style>
  @media (max-width: 600px) {
    .stats-charts-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
