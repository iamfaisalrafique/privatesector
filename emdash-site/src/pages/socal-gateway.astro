---
// emdash-site/src/pages/socal-gateway.astro
import Base from "../layouts/Base.astro";

const hubs = [
  { name: "Silicon Beach (LA)", sector: "Aerospace, Gaming, SaaS", desc: "Home to space exploration tech pioneers and major creative studios." },
  { name: "San Diego County", sector: "Biotech & Genomics", desc: "A world-leading cluster of life sciences research and commercialization." },
  { name: "Orange County", sector: "Clean Tech & Medical Devices", desc: "Strong manufacturing, medical equipment development, and capital presence." }
];
---

<Base title="The SoCal Gateway | PrivateSector.ch" description="Accelerating Swiss-American trade. Connecting Zurich, Geneva, and Zug to Southern California business ecosystems.">
  <div class="min-h-[calc(100vh-120px)] py-10 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav class="mb-8 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="transition hover:text-slate-900 dark:hover:text-white">Home</a>
        <span>/</span>
        <span class="font-semibold text-slate-900 dark:text-white">The SoCal Gateway</span>
      </nav>

      <!-- Header Block -->
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-red-200/60 bg-red-50/80 px-3.5 py-1 text-[11px] font-bold tracking-widest text-[#D52B1E] uppercase dark:border-red-900/40 dark:bg-red-950/40 dark:text-red-400">
          <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
          Transatlantic Corridors
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
          The SoCal Gateway
        </h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
          Accelerating Swiss-American trade. We connect Zurich, Geneva, and Zug to Los Angeles, San Diego, and Orange County business ecosystems.
        </p>
      </div>

      <!-- Main Layout Grid -->
      <div class="grid gap-10 lg:grid-cols-12">
        
        <!-- Main Expansion Roadmap Column -->
        <div class="space-y-10 lg:col-span-8">
          
          <!-- Expanding to Southern California -->
          <div class="rounded-3xl border border-slate-200/80 bg-white p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900 sm:p-10">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
              Expanding to Southern California
            </h2>

            <div class="mt-8 space-y-6">
              <div class="flex gap-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-red-50 text-sm font-bold text-[#D52B1E] dark:bg-red-950/50 dark:text-red-400">
                  1
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Local Incorporation & Entity Setup
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    Evaluate LLC vs. C-Corp state registrations. Delaware filing with California physical operations is the standard route for Swiss technical startups.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-red-50 text-sm font-bold text-[#D52B1E] dark:bg-red-950/50 dark:text-red-400">
                  2
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Tax Treaty Advisory & Compliance
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    Ensure alignment with the US-Swiss double taxation treaty to prevent redundant fiscal liabilities on cross-border licensing, dividends, and royalties.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-red-50 text-sm font-bold text-[#D52B1E] dark:bg-red-950/50 dark:text-red-400">
                  3
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Visa & Executive Relocation
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    Secure L-1 intra-company transfer visas or E-2 treaty investor visas for Swiss key executives establishing the Southern California footprint.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Establishing Swiss Entity from California -->
          <div class="rounded-3xl border border-slate-200/80 bg-white p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900 sm:p-10">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
              Establishing Swiss Entity from California
            </h2>

            <div class="mt-8 space-y-6">
              <div class="flex gap-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-200">
                  1
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Selecting the Ideal Canton
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    Zurich is ideal for global financial integrations, Zug for blockchain/DLT systems, and Vaud/Geneva for biological and health tech innovations.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-200">
                  2
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Notary & Capital Deposit
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    Create blocked bank accounts to deposit statutory capital (CHF 20,000 for GmbH, CHF 100,000 for AG) and execute the public deed of incorporation before a Swiss notary.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-200">
                  3
                </div>
                <div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white">
                    Workforce Integration & Permits
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    Understand labor regulations. Recruit technical talent locally or navigate the quotas for non-EU/EFTA highly skilled specialists from California.
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Sidebar: Hubs & Advisory Column -->
        <div class="space-y-6 lg:col-span-4">
          
          <div>
            <h3 class="mb-4 text-xs font-bold tracking-widest text-[#D52B1E] uppercase dark:text-red-400">
              Key SoCal Hubs
            </h3>
            <div class="space-y-4">
              {hubs.map((hub) => (
                <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xs transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                  <span class="inline-block rounded-full bg-red-50 px-2.5 py-0.5 text-[10px] font-bold tracking-wider text-[#D52B1E] uppercase dark:bg-red-950/50 dark:text-red-400">
                    {hub.sector}
                  </span>
                  <strong class="mt-2 block text-base font-bold text-slate-900 dark:text-white">
                    {hub.name}
                  </strong>
                  <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                    {hub.desc}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- Advisory Desk Box -->
          <div class="rounded-3xl border border-slate-200/80 bg-slate-50/70 p-6 text-center dark:border-slate-800 dark:bg-slate-900/50">
            <div class="text-3xl">🤝</div>
            <strong class="mt-3 block text-base font-bold text-slate-900 dark:text-white">
              Need Advisory Help?
            </strong>
            <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Our bi-national desks provide customized introductions to legal counsel, banks, and office space.
            </p>
            <div class="mt-6">
              <a 
                href="/contact"
                class="inline-flex w-full items-center justify-center rounded-full bg-[#0F172A] py-3 text-xs font-bold text-white shadow-xs transition hover:bg-slate-800 dark:bg-red-600 dark:hover:bg-red-500"
              >
                Inquire With Gateway Team
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</Base>
