---
// emdash-site/src/pages/trade-policy-pulse.astro
import Base from "../layouts/Base.astro";

const alerts = [
  { category: "Tax", title: "US-Swiss Double Taxation Amendment Approved", desc: "Reduces withholding taxes on intellectual property licensing and qualified dividend transfers.", date: "June 2026", status: "Active" },
  { category: "Compliance", title: "California Privacy Rights Act (CPRA) Updates", desc: "Affects Swiss B2B firms collecting marketing data from Southern California customers.", date: "May 2026", status: "Regulatory" },
  { category: "Tariffs", title: "Bilateral Machinery Tariff Exemption Extensions", desc: "Swiss high-precision mechanical tools maintain tariff exemptions at US ports of entry.", date: "April 2026", status: "Passed" }
];
---

<Base title="Trade & Policy Pulse | PrivateSector.ch" description="Monitors changes in tariffs, double taxation treaties, data privacy compliance, and logistics rules governing Swiss-American commerce.">
  <div class="min-h-[calc(100vh-120px)] py-10 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav class="mb-8 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="transition hover:text-slate-900 dark:hover:text-white">Home</a>
        <span>/</span>
        <span class="font-semibold text-slate-900 dark:text-white">Trade & Policy Pulse</span>
      </nav>

      <!-- Editorial Header -->
      <div class="mb-12">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-red-200/60 bg-red-50/80 px-3.5 py-1 text-[11px] font-bold tracking-widest text-[#D52B1E] uppercase dark:border-red-900/40 dark:bg-red-950/40 dark:text-red-400">
          <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
          Regulatory Tracking
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
          Trade & Policy Pulse
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
          Monitors changes in tariffs, double taxation treaties, data privacy compliance, and logistics rules governing Swiss-American commerce, with direct inputs from our Los Angeles office.
        </p>
      </div>

      <!-- 3 Metric Cards -->
      <div class="mb-14 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200/80 bg-white p-7 shadow-xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl">📈</div>
          <span class="mt-3 block text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400">
            Annual Trade Volume
          </span>
          <strong class="mt-2 block font-mono text-3xl font-extrabold text-slate-900 dark:text-white">
            $48.5 Billion
          </strong>
          <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Total trade in services, technology, and precision machinery.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-7 shadow-xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl">🏛️</div>
          <span class="mt-3 block text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400">
            Swiss FDI in California
          </span>
          <strong class="mt-2 block font-mono text-3xl font-extrabold text-slate-900 dark:text-white">
            $22.8 Billion
          </strong>
          <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Direct foreign investment supporting 100,000+ local jobs.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-7 shadow-xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl">🏢</div>
          <span class="mt-3 block text-xs font-bold tracking-wider text-slate-500 uppercase dark:text-slate-400">
            US Corporate Presence
          </span>
          <strong class="mt-2 block font-mono text-3xl font-extrabold text-slate-900 dark:text-white">
            750+ Entities
          </strong>
          <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Swiss subsidiaries in California and California offices in Switzerland.
          </p>
        </div>
      </div>

      <!-- Layout: Alerts Left, Checklist Right -->
      <div class="grid gap-10 lg:grid-cols-12">
        
        <!-- Policy updates list -->
        <div class="space-y-6 lg:col-span-8">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Active Regulatory Updates
          </h2>

          <div class="space-y-6">
            {alerts.map((al) => (
              <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xs transition hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                <div class="flex items-center justify-between gap-4">
                  <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-bold text-[#D52B1E] uppercase dark:bg-red-950/50 dark:text-red-400">
                    {al.category}
                  </span>
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {al.status}
                  </span>
                </div>
                <h3 class="mt-3 text-lg font-bold text-slate-900 dark:text-white">
                  {al.title}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                  {al.desc}
                </p>
                <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800/80 text-xs text-slate-400 font-mono">
                  Published: {al.date}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Interactive expansion checklist -->
        <div class="space-y-6 lg:col-span-4">
          <div class="rounded-3xl border border-slate-200/80 bg-slate-50/70 p-7 dark:border-slate-800 dark:bg-slate-900/50">
            <h3 class="text-xs font-bold tracking-widest text-[#D52B1E] uppercase dark:text-red-400">
              Transatlantic Compliance Checklist
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Ensure your cross-border operations conform to the latest standard legal checklists:
            </p>
            
            <div class="mt-6 space-y-4">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" class="mt-1 h-4 w-4 rounded-sm border-slate-300 text-red-600 focus:ring-red-500" />
                <div>
                  <strong class="block text-sm font-semibold text-slate-900 dark:text-white">Withholding Tax Compliance</strong>
                  <span class="block text-xs text-slate-500 dark:text-slate-400">Bilateral forms loaded under treaty updates.</span>
                </div>
              </label>

              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" class="mt-1 h-4 w-4 rounded-sm border-slate-300 text-red-600 focus:ring-red-500" />
                <div>
                  <strong class="block text-sm font-semibold text-slate-900 dark:text-white">State Corporate Nexus Assessment</strong>
                  <span class="block text-xs text-slate-500 dark:text-slate-400">Analyze physical vs. economic presence thresholds in California.</span>
                </div>
              </label>

              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" class="mt-1 h-4 w-4 rounded-sm border-slate-300 text-red-600 focus:ring-red-500" />
                <div>
                  <strong class="block text-sm font-semibold text-slate-900 dark:text-white">FADP & CCPA Data Sync</strong>
                  <span class="block text-xs text-slate-500 dark:text-slate-400">Reconcile Swiss Data Act provisions with California Consumer Privacy.</span>
                </div>
              </label>

              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" class="mt-1 h-4 w-4 rounded-sm border-slate-300 text-red-600 focus:ring-red-500" />
                <div>
                  <strong class="block text-sm font-semibold text-slate-900 dark:text-white">Treaty Investor Visa Verification</strong>
                  <span class="block text-xs text-slate-500 dark:text-slate-400">Confirm Swiss ownership ratios meet US E-2 requirements.</span>
                </div>
              </label>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</Base>
