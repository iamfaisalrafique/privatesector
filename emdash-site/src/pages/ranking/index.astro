---
// emdash-site/src/pages/ranking/index.astro
import Base from "../../layouts/Base.astro";
import { getCompanies } from "../../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";
const companies = await getCompanies(false, 50);
---

<Base
  title="Swiss Company League Rankings 2026 — PrivateSector.ch"
  description="Authoritative ranking and league table of Switzerland's top commercial enterprises and private sector powerhouses."
  locale={currentLocale}
>
  <!-- Header Bar -->
  <section class="bg-white dark:bg-[#0B0F19] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-red-50 dark:bg-red-950/80 text-red-700 dark:text-red-400 border border-red-200/60 dark:border-red-900/40 uppercase tracking-wider">
        LEADERBOARDS & BENCHMARKS
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Swiss Enterprise Leaderboard & Rankings
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Benchmarked directory ranking Switzerland's leading corporate multinationals, mid-market champions, and ESG leaders.
      </p>
    </div>
  </section>

  <!-- Table Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl overflow-hidden shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-850/60 border-b border-slate-200/80 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-[11px] uppercase tracking-wider font-bold">
              <th class="py-4 px-6">Rank</th>
              <th class="py-4 px-6">Enterprise</th>
              <th class="py-4 px-6">Canton</th>
              <th class="py-4 px-6">Sector</th>
              <th class="py-4 px-6">Employees</th>
              <th class="py-4 px-6">Status</th>
              <th class="py-4 px-6 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
            {companies.map((c: any, idx: number) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                <td class="py-4 px-6">
                  <span class={`inline-flex items-center justify-center w-8 h-8 rounded-xl text-xs font-mono font-extrabold tabular-nums ${
                    idx < 3 ? 'bg-[#D52B1E] text-white shadow-2xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
                  }`}>
                    #{idx + 1}
                  </span>
                </td>
                <td class="py-4 px-6">
                  <a 
                    href={`/unternehmen/${c.slug || c.id}`} 
                    class="font-bold text-slate-900 dark:text-white hover:text-red-600 dark:hover:text-red-400 transition-colors"
                  >
                    {c.name}
                  </a>
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300">
                  📍 {c.canton || 'Switzerland'}
                </td>
                <td class="py-4 px-6 text-slate-500 dark:text-slate-400">
                  {c.industry || 'Enterprise'}
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-mono tabular-nums">
                  {c.employees || 'Confidential'}
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-semibold text-[11px] bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Active
                  </span>
                </td>
                <td class="py-4 px-6 text-right">
                  <a 
                    href={`/unternehmen/${c.slug || c.id}`} 
                    class="text-xs font-semibold text-red-600 dark:text-red-400 hover:underline"
                  >
                    Dossier →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</Base>
