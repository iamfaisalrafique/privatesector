---
// emdash-site/src/pages/unternehmen/[id].astro
import Base from "../../layouts/Base.astro";
import { getCompanyById, getCompanies } from "../../lib/legacy-db";

const idOrSlug = Astro.params.id;
if (!idOrSlug) {
  return Astro.redirect("/unternehmen");
}

const company = getCompanyById(idOrSlug);
if (!company) {
  return Astro.redirect("/404");
}

const logoInitial = company.name ? company.name.charAt(0) : 'C';
const isPremium = company.premium === 1 || company.premium === true;
const isVerified = company.verified === 1 || company.verified === true;

// Peer companies in same industry or canton
const peerCompanies = getCompanies(false, 4).filter((c: any) => String(c.id) !== String(company.id)).slice(0, 3);
---

<Base
  title={`${company.name} — Swiss Company Profile | PrivateSector.ch`}
  description={company.description || `Verified commercial intelligence and corporate factsheet for ${company.name}.`}
>
  <!-- Header Bar -->
  <div style="background-color: #FFFFFF; border-bottom: 1px solid #E5E7EB; padding: 40px 24px;">
    <div style="max-width: 1100px; margin: 0 auto;">
      
      <nav style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #6B7280; margin-bottom: 24px;">
        <a href="/" style="color: #6B7280; text-decoration: none;">Home</a>
        <span>›</span>
        <a href="/unternehmen" style="color: #6B7280; text-decoration: none;">Directory</a>
        <span>›</span>
        <span style="color: #D52B1E; font-weight: 600;">{company.name}</span>
      </nav>

      <div style="display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap;">
        <!-- Logo initial box -->
        <div 
          style={`
            width: 80px;
            height: 80px;
            background-color: ${company.logo_bg || '#F9FAFB'};
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000000;
            font-size: 36px;
            font-weight: 700;
            font-family: 'Playfair Display', Georgia, serif;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(0,0,0,0.04);
          `}
        >
          {logoInitial}
        </div>

        <div style="flex: 1; min-width: 280px;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap;">
            <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 32px; font-weight: 700; color: #000000; margin: 0;">
              {company.name}
            </h1>
            {isVerified && (
              <span style="background-color: #ECFDF5; color: #059669; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px; border: 1px solid #A7F3D0; display: inline-flex; align-items: center; gap: 4px;">
                ✓ Verified Swiss Enterprise
              </span>
            )}
            {isPremium && (
              <span style="background-color: #FFF5F5; color: #D52B1E; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(213,43,30,0.2);">
                Premium Member
              </span>
            )}
          </div>

          <div style="display: flex; align-items: center; gap: 12px; font-size: 13px; color: #6B7280; flex-wrap: wrap;">
            {company.canton && <span>📍 Canton of {company.canton}</span>}
            {company.industry && <span>• 🏭 {company.industry}</span>}
            {company.founded && <span>• 🏛️ Established {company.founded}</span>}
          </div>

          {company.description && (
            <p style="font-size: 15px; color: #4B5563; line-height: 1.6; margin: 16px 0 0 0;">
              {company.description}
            </p>
          )}
        </div>
      </div>

    </div>
  </div>

  <!-- Main Profile Body -->
  <main style="max-width: 1100px; margin: 0 auto; padding: 48px 24px 96px;">
    
    <div style="display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 48px;" class="profile-layout">
      
      <!-- Left Column: Dossier -->
      <div>
        
        <!-- Corporate Factsheet Matrix -->
        <section style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; margin-bottom: 36px;">
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; color: #000000; margin: 0 0 20px 0; border-bottom: 1px solid #F3F4F6; padding-bottom: 12px;">
            Corporate Indicators & Metrics
          </h2>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: #6B7280; font-weight: 600; display: block;">Headquarters</span>
              <strong style="font-size: 15px; color: #111827;">Canton {company.canton || 'Switzerland'}</strong>
            </div>

            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: #6B7280; font-weight: 600; display: block;">Primary Industry</span>
              <strong style="font-size: 15px; color: #111827;">{company.industry || 'Commercial Enterprise'}</strong>
            </div>

            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: #6B7280; font-weight: 600; display: block;">Workforce Size</span>
              <strong style="font-size: 15px; color: #111827;">{company.employees || 'Confidential'}</strong>
            </div>

            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: #6B7280; font-weight: 600; display: block;">Revenue Band</span>
              <strong style="font-size: 15px; color: #111827;">{company.revenue_band || 'Disclosed to SOGC'}</strong>
            </div>

            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: #6B7280; font-weight: 600; display: block;">ESG Rating</span>
              <strong style="font-size: 15px; color: #059669;">{company.esg_rating || 'Tier-1 Rated'}</strong>
            </div>

            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: #6B7280; font-weight: 600; display: block;">Registry Status</span>
              <strong style="font-size: 15px; color: #111827;">Active (CH-UID Verified)</strong>
            </div>
          </div>
        </section>

        <!-- About Text -->
        {company.about_text && (
          <section style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; margin-bottom: 36px;">
            <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; color: #000000; margin: 0 0 16px 0;">
              Executive Overview
            </h2>
            <div style="font-size: 15px; line-height: 1.8; color: #374151; white-space: pre-wrap;">
              {company.about_text}
            </div>
          </section>
        )}

        <!-- Sustainability / ESG Summary -->
        {company.sustainability_summary && (
          <section style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px;">
            <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; color: #000000; margin: 0 0 16px 0;">
              Sustainability & ESG Compliance
            </h2>
            <p style="font-size: 15px; line-height: 1.8; color: #374151;">
              {company.sustainability_summary}
            </p>
          </section>
        )}

      </div>

      <!-- Right Column: Sidebar Contacts & Peers -->
      <div>
        <div style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px; margin-bottom: 24px;">
          <h3 style="font-size: 15px; font-weight: 700; color: #000000; margin: 0 0 16px 0; border-bottom: 1px solid #F3F4F6; padding-bottom: 8px;">
            Official Corporate Links
          </h3>

          <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
            {company.website && (
              <a href={company.website} target="_blank" rel="noopener noreferrer" style="color: #D52B1E; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                🌐 Official Website ↗
              </a>
            )}
            {company.linkedin && (
              <a href={company.linkedin} target="_blank" rel="noopener noreferrer" style="color: #0A66C2; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                💼 LinkedIn Page ↗
              </a>
            )}
            {company.contact_email && (
              <a href={`mailto:${company.contact_email}`} style="color: #374151; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                ✉️ {company.contact_email}
              </a>
            )}
          </div>
        </div>

        <!-- Peer Companies -->
        {peerCompanies.length > 0 && (
          <div style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; padding: 24px;">
            <h3 style="font-size: 15px; font-weight: 700; color: #000000; margin: 0 0 16px 0; border-bottom: 1px solid #F3F4F6; padding-bottom: 8px;">
              Industry Peers
            </h3>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              {peerCompanies.map((peer: any) => (
                <a href={`/unternehmen/${peer.slug || peer.id}`} style="text-decoration: none; color: #111827; font-size: 13px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #F9FAFB; padding-bottom: 8px;">
                  <span>{peer.name}</span>
                  <span style="color: #9CA3AF; font-size: 11px;">{peer.canton}</span>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

    </div>

  </main>
</Base>

<style>
  @media (max-width: 840px) {
    .profile-layout {
      grid-template-columns: 1fr !important;
    }
  }
</style>
