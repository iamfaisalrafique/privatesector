---
// emdash-site/src/pages/unternehmen/[id].astro
import Base from "../../layouts/Base.astro";
import { getCompanyById, getCompanies } from "../../lib/legacy-db";

const idOrSlug = Astro.params.id;
if (!idOrSlug) {
  return Astro.redirect("/unternehmen");
}

const company = getCompanyById(idOrSlug) as any;
if (!company) {
  return Astro.redirect("/404");
}

const logoInitial = company.name ? String(company.name).charAt(0) : 'C';
const isPremium = company.premium === 1 || Boolean(company.premium);
const isVerified = company.verified === 1 || Boolean(company.verified);

// Peer companies in same industry or canton
const peerCompanies = getCompanies(false, 4).filter((c: any) => String(c.id) !== String(company.id)).slice(0, 3);
---

<Base
  title={`${company.name} — Swiss Company Profile | PrivateSector.ch`}
  description={company.description || `Verified commercial intelligence and corporate factsheet for ${company.name}.`}
>
  <!-- Header Bar -->
  <header class="bg-white dark:bg-[#0B0F19] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-slate-900 dark:hover:white transition-colors">Home</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <a href="/unternehmen" class="hover:text-slate-900 dark:hover:text-white transition-colors">Directory</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="text-red-600 dark:text-red-400 font-semibold truncate max-w-[200px]">{company.name}</span>
      </nav>

      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <!-- Logo Initial Avatar Container -->
        <div 
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl flex items-center justify-center font-extrabold text-2xl sm:text-3xl text-slate-900 dark:text-white border border-slate-200/80 dark:border-slate-700/80 shadow-sm shrink-0"
          style={`background-color: ${company.logo_bg || '#F1F5F9'};`}
        >
          {logoInitial}
        </div>

        <div class="flex-1 space-y-3">
          <div class="flex items-center gap-3 flex-wrap">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
              {company.name}
            </h1>
            {isVerified && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800/60 shadow-2xs">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span>Verified Swiss Entity</span>
              </span>
            )}
            {isPremium && (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900/60 uppercase tracking-wider">
                PREMIUM
              </span>
            )}
          </div>

          <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 flex-wrap font-medium">
            {company.canton && (
              <span class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                📍 Canton {company.canton}
              </span>
            )}
            {company.industry && (
              <span class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                🏭 {company.industry}
              </span>
            )}
            {company.founded && (
              <span class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono">
                Est. {company.founded}
              </span>
            )}
          </div>

          {company.description && (
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl pt-1">
              {company.description}
            </p>
          )}
        </div>
      </div>

    </div>
  </header>

  <!-- Main Profile Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Dossier Indicators & Narrative -->
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Corporate Factsheet Matrix -->
        <section class="bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-8 shadow-xs">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100 dark:border-slate-800/80">
            <div>
              <span class="text-[11px] font-bold text-red-600 dark:text-red-400 uppercase tracking-wider block">STATUTORY INDICATORS</span>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                Corporate Factsheet & Commercial Matrix
              </h2>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500">UID: SOGC-SYNCHRONIZED</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60">
              <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Headquarters</span>
              <strong class="text-sm font-semibold text-slate-900 dark:text-white">Canton {company.canton || 'Switzerland'}</strong>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60">
              <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Primary Industry</span>
              <strong class="text-sm font-semibold text-slate-900 dark:text-white truncate block">{company.industry || 'Commercial Enterprise'}</strong>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60">
              <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Workforce</span>
              <strong class="text-sm font-semibold font-mono text-slate-900 dark:text-white tabular-nums">{company.employees || 'Confidential'}</strong>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60">
              <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Revenue Band</span>
              <strong class="text-sm font-semibold text-slate-900 dark:text-white">{company.revenue_band || 'Disclosed to SOGC'}</strong>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60">
              <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">ESG Rating</span>
              <strong class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">{company.esg_rating || 'Tier-1 Rated'}</strong>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/60">
              <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Registry Status</span>
              <strong class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Active (CH-UID)
              </strong>
            </div>
          </div>
        </section>

        <!-- Executive Overview -->
        {company.about_text && (
          <section class="bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-8 shadow-xs space-y-4">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800/80">
              Executive Overview
            </h2>
            <div class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-wrap">
              {company.about_text}
            </div>
          </section>
        )}

        <!-- Sustainability / ESG Summary -->
        {company.sustainability_summary && (
          <section class="bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-8 shadow-xs space-y-4">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800/80">
              Sustainability & ESG Compliance
            </h2>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              {company.sustainability_summary}
            </p>
          </section>
        )}

      </div>

      <!-- Right Column: Corporate Links & Industry Peers -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Official Links Card -->
        <div class="bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800">
            Corporate Channels
          </h3>

          <div class="space-y-3 text-xs sm:text-sm">
            {company.website && (
              <a 
                href={String(company.website)} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 hover:bg-red-50 dark:hover:bg-red-950/40 text-red-600 dark:text-red-400 font-semibold transition-colors group"
              >
                <div class="flex items-center gap-2 truncate">
                  <span>🌐</span>
                  <span class="truncate">Official Website</span>
                </div>
                <span class="text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
              </a>
            )}
            {company.linkedin && (
              <a 
                href={String(company.linkedin)} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-blue-600 dark:text-blue-400 font-semibold transition-colors group"
              >
                <div class="flex items-center gap-2 truncate">
                  <span>💼</span>
                  <span class="truncate">LinkedIn Corporate Page</span>
                </div>
                <span class="text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
              </a>
            )}
            {company.contact_email && (
              <a 
                href={`mailto:${String(company.contact_email)}`} 
                class="flex items-center gap-2.5 p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-red-400 transition-colors"
              >
                <span>✉️</span>
                <span class="truncate font-mono text-xs">{company.contact_email}</span>
              </a>
            )}
          </div>
        </div>

        <!-- Industry Peers Card -->
        {peerCompanies.length > 0 && (
          <div class="bg-white dark:bg-[#0E1524] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800">
              Sector Peers
            </h3>

            <div class="space-y-2">
              {peerCompanies.map((peer: any) => (
                <a 
                  href={`/unternehmen/${peer.slug || peer.id}`} 
                  class="flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800/70 transition-colors group"
                >
                  <span class="font-semibold text-xs sm:text-sm text-slate-800 dark:text-slate-200 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors truncate">
                    {peer.name}
                  </span>
                  <span class="text-xs text-slate-500 px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 shrink-0 font-medium">
                    {peer.canton}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

    </div>
  </main>
</Base>
