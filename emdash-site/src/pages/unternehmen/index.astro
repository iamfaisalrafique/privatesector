---
// emdash-site/src/pages/unternehmen/index.astro
import Base from "../../layouts/Base.astro";
import CompanyCard from "../../components/CompanyCard.astro";
import { getCompanies } from "../../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";
const searchParam = url.searchParams.get("search")?.toLowerCase() || "";
const cantonParam = url.searchParams.get("canton")?.toUpperCase() || "";
const verifiedOnly = url.searchParams.get("verified") === "true";

let companies = getCompanies(false, 100);

if (verifiedOnly) {
  companies = companies.filter((c: any) => c.verified === 1 || c.verified === true);
}

if (cantonParam) {
  companies = companies.filter((c: any) => c.canton && c.canton.toUpperCase() === cantonParam);
}

if (searchParam) {
  companies = companies.filter((c: any) => 
    (c.name && c.name.toLowerCase().includes(searchParam)) ||
    (c.description && c.description.toLowerCase().includes(searchParam)) ||
    (c.industry && c.industry.toLowerCase().includes(searchParam))
  );
}

const cantons = ["All", "ZH", "BE", "GE", "VD", "BS", "ZG", "SG", "AG"];
---

<Base 
  title="Swiss Company Directory & Verified Registry — PrivateSector.ch"
  description="Search and explore verified Swiss enterprises, market leaders, and commercial entities across all 26 Cantons."
  locale={currentLocale}
>
  <!-- Directory Header -->
  <section class="bg-white dark:bg-[#0E1524] border-b border-slate-200/80 dark:border-slate-800/80 py-10 sm:py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <div class="space-y-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 uppercase tracking-wider">
          SWISS COMMERCIAL REGISTRY
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Swiss Enterprise Directory
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          Verified commercial registry dossiers, corporate structure intelligence, and key market analytics across Switzerland's leading commercial enterprises.
        </p>
      </div>

      <!-- Filters & Search -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
        <!-- Canton Filter Chips -->
        <div class="flex items-center gap-1.5 flex-wrap">
          {cantons.map((can) => {
            const isCanActive = (!cantonParam && can === "All") || (cantonParam === can);
            return (
              <a 
                href={can === "All" ? "/unternehmen" : `/unternehmen?canton=${can}`}
                class={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-all shadow-2xs ${
                  isCanActive
                    ? 'bg-[#D52B1E] text-white shadow-xs'
                    : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700'
                }`}
              >
                {can}
              </a>
            );
          })}
        </div>

        <!-- Search Bar -->
        <form action="/unternehmen" method="GET" class="relative max-w-xs w-full flex items-center">
          <input 
            type="text" 
            name="search" 
            placeholder="Search by company or sector..." 
            value={searchParam}
            class="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white rounded-full border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-1 focus:ring-red-500"
          />
          <svg class="absolute left-3 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
            <path d="m21 21-4.35-4.35" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </form>
      </div>

    </div>
  </section>

  <!-- Directory Cards Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="flex items-center justify-between mb-6 text-xs text-slate-500 dark:text-slate-400 font-medium">
      <span>Showing {companies.length} corporate profiles</span>
      {(cantonParam || searchParam || verifiedOnly) && (
        <a href="/unternehmen" class="text-red-600 dark:text-red-400 font-semibold hover:underline">
          Clear all filters ✕
        </a>
      )}
    </div>

    {companies.length === 0 ? (
      <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-8 shadow-xs">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">No enterprises match your search query</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Try clearing filters or searching across all cantons.</p>
        <a href="/unternehmen" class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-semibold bg-red-600 text-white">
          Reset all filters
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {companies.map((comp: any) => (
          <CompanyCard company={comp} />
        ))}
      </div>
    )}
  </main>
</Base>
