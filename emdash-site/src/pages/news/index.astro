---
// emdash-site/src/pages/news/index.astro
import Base from "../../layouts/Base.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getNews } from "../../lib/legacy-db";

const url = new URL(Astro.request.url);
const currentLocale = url.searchParams.get("locale") || "en";
const searchParam = url.searchParams.get("search")?.toLowerCase() || "";
const categoryParam = url.searchParams.get("category")?.toLowerCase() || "";

let allNews = getNews(100);

if (categoryParam) {
  allNews = allNews.filter((n: any) => n.category && n.category.toLowerCase().includes(categoryParam));
}

if (searchParam) {
  allNews = allNews.filter((n: any) => 
    (n.title && n.title.toLowerCase().includes(searchParam)) ||
    (n.subtitle && n.subtitle.toLowerCase().includes(searchParam))
  );
}

const categories = ["All", "Pharma", "Banking", "Technology", "Logistics", "Energy", "Startups", "Trade"];
---

<Base 
  title="News & Market Intelligence — PrivateSector.ch"
  description="Comprehensive editorial reporting and independent intelligence on Switzerland's private sector enterprises."
  locale={currentLocale}
>
  <!-- Modern Header Section -->
  <section class="border-b border-slate-200/80 bg-white/70 py-12 sm:py-16 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-900/70 transition-colors">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      
      <div class="space-y-3">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[11px] font-bold tracking-widest text-[#D52B1E] uppercase dark:border-red-900/40 dark:bg-red-950/40 dark:text-red-400">
          <span class="h-1.5 w-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
          EDITORIAL ARCHIVES
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
          News & Market Intelligence
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
          Authoritative investigations, economic briefings, and market updates across Switzerland's leading corporate sectors.
        </p>
      </div>

      <!-- Filter Controls: Categories & Search -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-4 border-t border-slate-100 dark:border-slate-800">
        <!-- Category Filter Pills -->
        <div class="flex items-center gap-2 flex-wrap">
          {categories.map((cat) => {
            const isCatActive = (!categoryParam && cat === "All") || (categoryParam === cat.toLowerCase());
            return (
              <a 
                href={cat === "All" ? "/news" : `/news?category=${encodeURIComponent(cat.toLowerCase())}`}
                class={`px-4 py-1.5 rounded-full text-xs font-semibold transition-all shadow-2xs ${
                  isCatActive
                    ? 'bg-[#D52B1E] text-white shadow-xs'
                    : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700'
                }`}
              >
                {cat}
              </a>
            );
          })}
        </div>

        <!-- Search Input -->
        <form action="/news" method="GET" class="relative max-w-xs w-full flex items-center">
          <input 
            type="text" 
            name="search" 
            placeholder="Search news..." 
            value={searchParam}
            class="w-full pl-9 pr-4 py-2 text-xs bg-white dark:bg-slate-800 text-slate-900 dark:text-white rounded-full border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-[#D52B1E] focus:ring-2 focus:ring-red-100 dark:focus:ring-red-950/40"
          />
          <svg class="absolute left-3 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
            <path d="m21 21-4.35-4.35" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </form>
      </div>

    </div>
  </section>

  <!-- News Grid Container -->
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="flex items-center justify-between mb-8 text-xs text-slate-500 dark:text-slate-400 font-medium">
      <span class="font-mono">Showing {allNews.length} verified reports</span>
      {(categoryParam || searchParam) && (
        <a href="/news" class="text-[#D52B1E] dark:text-red-400 font-semibold hover:underline">
          Clear filters ✕
        </a>
      )}
    </div>

    {allNews.length === 0 ? (
      <div class="text-center py-20 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-8">
        <span class="text-3xl block mb-2">🔎</span>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">No reports match your filter</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Try another keyword or explore all articles.</p>
        <a href="/news" class="mt-4 inline-block px-4 py-2 rounded-full bg-[#0F172A] text-white text-xs font-semibold">
          Reset Filter
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {allNews.map((article: any) => (
          <NewsCard article={article} />
        ))}
      </div>
    )}
  </main>
</Base>
