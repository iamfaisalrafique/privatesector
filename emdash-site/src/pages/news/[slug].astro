---
// emdash-site/src/pages/news/[slug].astro
import {
  getEmDashEntry,
  decodeSlug,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import newsRedirects from "../../data/news-redirects.json";
import { getNewsBySlug, getNews } from "../../lib/legacy-db";
import { marked } from "marked";

const rawSlug = Astro.params.slug;
const slug = decodeSlug(rawSlug);

if (!slug) {
  return Astro.redirect("/404");
}

// 1. Production-Only Numeric ID Legacy Redirection (Strict 301)
if (/^\d+$/.test(slug)) {
  const targetSlug = (newsRedirects as Record<string, string>)[slug];
  if (targetSlug) {
    return Astro.redirect(`/news/${targetSlug}`, 301);
  }
}

// 2. Fetch from EmDash Live Collection
let post: any = null;
let isEmDash = false;
try {
  const res = await getEmDashEntry("posts", slug);
  if (res?.entry) {
    post = res.entry;
    isEmDash = true;
    if (Astro.cache?.enabled) Astro.cache.set(res.cacheHint);
  }
} catch (e) {}

// 3. Fallback to native backend database
let nativeArticle: any = null;
let renderedHtml = "";
if (!post) {
  nativeArticle = getNewsBySlug(slug);
  if (!nativeArticle) {
    return Astro.redirect("/404");
  }
  renderedHtml = nativeArticle.content_body ? (marked.parse(nativeArticle.content_body) as string) : "";
}

function resolveMediaUrl(rawImage: any): string | null {
  if (!rawImage) return null;
  if (typeof rawImage === 'string') {
    if (rawImage.startsWith('/') || rawImage.startsWith('http')) return rawImage;
    if (rawImage.trim().startsWith('{')) {
      try {
        const parsed = JSON.parse(rawImage);
        if (parsed.meta?.storageKey) return `/_emdash/api/media/file/${parsed.meta.storageKey}`;
        if (parsed.filename) return `/_emdash/api/media/file/${parsed.filename}`;
      } catch {}
    }
    return rawImage;
  }
  if (typeof rawImage === 'object') {
    if (rawImage.meta?.storageKey) return `/_emdash/api/media/file/${rawImage.meta.storageKey}`;
    if (rawImage.filename) return `/_emdash/api/media/file/${rawImage.filename}`;
  }
  return null;
}

const pageTitle = isEmDash ? post.data.title : nativeArticle.title;
const pageSubtitle = isEmDash ? post.data.subtitle : nativeArticle.subtitle;
const pageDateRaw = isEmDash ? post.data.publishedAt : nativeArticle.date_published;
const pageCategory = isEmDash 
  ? (post.data.terms?.category?.[0]?.label || "Swiss Intelligence") 
  : (nativeArticle.category || "Swiss Intelligence");
const pageImage = isEmDash ? resolveMediaUrl(post.data.featured_image) : nativeArticle.image_url;
const authorName = isEmDash ? (post.data.author_name || "PrivateSector Editorial") : (nativeArticle.author_name || "PrivateSector Editorial");
const readTime = isEmDash ? post.data.read_time_mins : nativeArticle.read_time_mins;
const pullQuote = isEmDash ? post.data.pull_quote : nativeArticle.pull_quote;

function formatDisplayDate(d?: string | null): string {
  if (!d) return '';
  try {
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return d;
    return dt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  } catch {
    return d;
  }
}
const displayDate = formatDisplayDate(pageDateRaw);

// Related articles for sidebar / footer
const relatedArticles = getNews(6).filter((n: any) => n.slug !== slug && String(n.id) !== slug).slice(0, 3);
---

<Base
  title={pageTitle}
  description={pageSubtitle || pageTitle}
  image={pageImage || "/logo.png"}
>
  <!-- Article Header & Hero Container -->
  <header class="border-b border-slate-200/80 bg-white/70 pt-10 pb-12 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-900/70 transition-colors">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span>›</span>
        <a href="/news" class="hover:text-slate-900 dark:hover:text-white transition-colors">News</a>
        <span>›</span>
        <span class="text-[#D52B1E] dark:text-red-400 font-semibold">{pageCategory}</span>
      </nav>

      <!-- Category Pill -->
      <div>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-950/80 text-[#D52B1E] dark:text-red-400 border border-red-200/80 dark:border-red-900/50 uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-[#D52B1E] dark:bg-red-400"></span>
          {pageCategory}
        </span>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.18] hyphen-guard">
        {pageTitle}
      </h1>

      <!-- Subtitle Lead -->
      {pageSubtitle && (
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          {pageSubtitle}
        </p>
      )}

      <!-- Author Byline & Meta Strip -->
      <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center font-bold text-xs shadow-xs">
            PS
          </div>
          <div>
            <span class="font-bold text-slate-900 dark:text-white text-sm block">
              {authorName}
            </span>
            <span class="text-[11px] text-slate-400">
              PrivateSector Bureau Zurich • Editorial Staff
            </span>
          </div>
        </div>

        <div class="flex items-center gap-4 tabular-nums text-xs font-mono">
          {displayDate && (
            <span class="flex items-center gap-1.5">
              <span>📅</span>
              <span>{displayDate}</span>
            </span>
          )}
          {readTime && (
            <span class="flex items-center gap-1.5">
              <span>⏱️</span>
              <span>{readTime} min read</span>
            </span>
          )}
        </div>
      </div>

    </div>
  </header>

  <!-- Main Article Body -->
  <main class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    
    <!-- High-Resolution Featured Image (Fitted without cropping or cutting) -->
    {pageImage && (
      <div class="mb-12 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-md bg-slate-50 dark:bg-slate-900/60 p-2 sm:p-3 overflow-hidden">
        <img 
          src={pageImage} 
          alt={pageTitle} 
          class="w-full h-auto max-h-[700px] rounded-2xl object-contain mx-auto" 
          onerror="this.style.display='none'" 
        />
      </div>
    )}

    <!-- Editorial Pullquote -->
    {pullQuote && (
      <blockquote class="my-10 p-7 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border-l-4 border-[#D52B1E] text-lg sm:text-xl font-medium italic text-slate-800 dark:text-slate-200 shadow-xs leading-relaxed">
        "{pullQuote}"
      </blockquote>
    )}

    <!-- Word-by-Word Exact Article Prose (1000% Fidelity) -->
    <article class="editorial-prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg">
      {isEmDash && post.data.content ? (
        <PortableText value={post.data.content} />
      ) : renderedHtml ? (
        <div set:html={renderedHtml} />
      ) : null}
    </article>

    <!-- Social Share & Return Actions -->
    <div class="mt-14 pt-8 border-t border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">SHARE:</span>
        <button 
          id="copy-share-btn"
          type="button"
          class="px-4 py-2 rounded-full text-xs font-semibold bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors flex items-center gap-1.5 shadow-2xs"
        >
          <span>📋</span>
          <span id="copy-btn-text">Copy Link</span>
        </button>
      </div>

      <a 
        href="/news" 
        class="text-xs font-bold text-[#D52B1E] dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 flex items-center gap-1"
      >
        <span>← Back to All News Archives</span>
      </a>
    </div>

    <!-- Related Articles Section -->
    {relatedArticles.length > 0 && (
      <section class="mt-16 pt-10 border-t border-slate-200/80 dark:border-slate-800">
        <div class="mb-6">
          <span class="text-[11px] font-bold text-[#D52B1E] dark:text-red-400 uppercase tracking-wider block">
            CONTINUE READING
          </span>
          <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1">
            Related Swiss Intelligence
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relatedArticles.map((rel: any) => (
            <a 
              href={`/news/${rel.slug || rel.id}`}
              class="group flex flex-col justify-between bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1 transition-all"
            >
              {rel.image_url && (
                <div class="aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
                  <img 
                    src={rel.image_url} 
                    alt="" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                    onerror="this.style.display='none'" 
                  />
                </div>
              )}
              <div class="p-5 space-y-2 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-bold text-[#D52B1E] dark:text-red-400 uppercase tracking-wider block">
                    {rel.category || 'News'}
                  </span>
                  <h4 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-[#D52B1E] dark:group-hover:text-red-400 transition-colors line-clamp-2 mt-1">
                    {rel.title}
                  </h4>
                </div>
                <span class="text-xs font-bold text-[#D52B1E] dark:text-red-400 mt-3 block">
                  Read Analysis →
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</Base>

<script is:inline data-astro-rerun>
  const copyBtn = document.getElementById('copy-share-btn');
  const copyText = document.getElementById('copy-btn-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyText.textContent = 'Copied! ✓';
        setTimeout(() => {
          copyText.textContent = 'Copy Link';
        }, 2000);
      } catch (err) {
        copyText.textContent = 'Link Copied';
      }
    });
  }
</script>
