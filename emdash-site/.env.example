# EmDash CMS Configuration
# Required: 32-byte hex encryption key generated via `npx emdash secrets generate`
EMDASH_ENCRYPTION_KEY=

# EmDash Database Configuration (PostgreSQL standalone or Coolify service)
# When set, EmDash connects via PostgreSQL adapter to its dedicated database/schema
EMDASH_DATABASE_URL=
EMDASH_DATABASE_SCHEMA=emdash_core

# Legacy / Application Database Connection (PostgreSQL read-only for migrations and application data)
DATABASE_URL=

# Media Storage Configuration (Local or S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Server & Network Configuration
PORT=4321
HOST=0.0.0.0
NODE_ENV=production

# Security & Admin Access
SESSION_SECRET=
ADMIN_ALLOWED_IPS=
